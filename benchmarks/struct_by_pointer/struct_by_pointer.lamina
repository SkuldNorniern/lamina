# A struct owned by main is handed to a helper by pointer. The helper reads and
# writes the two fields through loads and stores inside a loop, and main reads
# them back afterwards.

fn @accumulate(ptr %count_p, ptr %total_p, i64 %n) -> i64 {
  entry:
    %i = add.i64 0, 0
    jmp head

  head:
    %more = lt.i64 %i, %n
    br %more, body, done

  body:
    %c = load.i64 %count_p
    %c1 = add.i64 %c, 1
    store.i64 %count_p, %c1
    %t = load.i64 %total_p
    %t1 = add.i64 %t, %i
    store.i64 %total_p, %t1
    %i = add.i64 %i, 1
    jmp head

  done:
    ret.i64 0
}

@export
fn @main() -> i64 {
  entry:
    %s = stackalloc.struct { count: i64, total: i64, scale: i64 }
    %cp = getfieldptr.struct { count: i64, total: i64, scale: i64 } %s, 0
    %tp = getfieldptr.struct { count: i64, total: i64, scale: i64 } %s, 1
    %sc = getfieldptr.struct { count: i64, total: i64, scale: i64 } %s, 2
    store.i64 %cp, 0
    store.i64 %tp, 0
    store.i64 %sc, 7
    %r1 = call @accumulate(%cp, %tp, 216000000)
    %r2 = call @accumulate(%cp, %tp, 144000000)
    %count = load.i64 %cp
    %total = load.i64 %tp
    %scale = load.i64 %sc
    call @print_i64(%count)
    call @print_i64(%total)
    call @print_i64(%scale)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
