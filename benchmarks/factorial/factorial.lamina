# Factorial Benchmark
# Computes factorial of 10, 12, 15, and 18 using iterative approach

# Iterative factorial function
fn @factorial_iterative(i64 %n) -> i64 {
  entry:
    # Handle base cases: 0! = 1, 1! = 1
    %is_zero = eq.i64 %n, 0
    br %is_zero, base_case, check_one

  check_one:
    %is_one = eq.i64 %n, 1
    br %is_one, base_case, compute_loop

  base_case:
    ret.i64 1

  compute_loop:
    # Initialize result and counter
    %result = add.i64 1, 0
    %i = add.i64 2, 0
    jmp loop_start

  loop_start:
    # Check if we've reached n
    %done = gt.i64 %i, %n
    br %done, loop_end, loop_body

  loop_body:
    # result = result * i
    %result = mul.i64 %result, %i
    # i = i + 1
    %i = add.i64 %i, 1
    jmp loop_start

  loop_end:
    ret.i64 %result
}

# Main function - exported as the program entry point
@export
fn @main() -> i64 {
  entry:
    # Print header marker
    %header = add.i64 123456789, 0
    call @print_i64(%header)

    # Compute and print factorial(10)
    %fact10 = call @factorial_iterative(10)
    call @print_i64(%fact10)

    # Compute and print factorial(12)
    %fact12 = call @factorial_iterative(12)
    call @print_i64(%fact12)

    # Compute and print factorial(15)
    %fact15 = call @factorial_iterative(15)
    call @print_i64(%fact15)

    # Compute and print factorial(18)
    %fact18 = call @factorial_iterative(18)
    call @print_i64(%fact18)

    %acc = add.i64 0, 0
    %sweep = add.i64 0, 0
    jmp sweep_head

  sweep_head:
    %sweep_more = lt.i64 %sweep, 50000000
    br %sweep_more, sweep_body, sweep_done

  sweep_body:
    %arg = rem.i64 %sweep, 20
    %value = call @factorial_iterative(%arg)
    %acc = add.i64 %acc, %value
    %sweep = add.i64 %sweep, 1
    jmp sweep_head

  sweep_done:
    %acc_u = bitcast.i64.u64 %acc
    call @print_u64(%acc_u)

    # Print footer marker
    %footer = add.i64 987654321, 0
    call @print_i64(%footer)

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
