# Hot loop over a stack array of scalars. The base address and the scale factor
# are loop invariant in the scan, and the accumulators are plain locals.

@export
fn @main() -> i64 {
  entry:
    %arr = stackalloc.[256 x i64]
    %i = add.i64 0, 0
    jmp fill_head

  fill_head:
    %fill_more = lt.i64 %i, 256
    br %fill_more, fill_body, fill_done

  fill_body:
    %slot = getelem.i64 %arr, %i
    %v = mul.i64 %i, 7
    %v1 = add.i64 %v, 3
    store.i64 %slot, %v1
    %i = add.i64 %i, 1
    jmp fill_head

  fill_done:
    %pass = add.i64 0, 0
    %total = add.i64 0, 0
    jmp pass_head

  pass_head:
    %pass_more = lt.i64 %pass, 60000
    br %pass_more, pass_body, pass_done

  pass_body:
    %k = add.i64 0, 0
    jmp scan_head

  scan_head:
    %scan_more = lt.i64 %k, 256
    br %scan_more, scan_body, scan_done

  scan_body:
    %scale = mul.i64 %pass, 3
    %q = getelem.i64 %arr, %k
    %x = load.i64 %q
    %term = mul.i64 %x, %scale
    %total = add.i64 %total, %term
    %k = add.i64 %k, 1
    jmp scan_head

  scan_done:
    %pass = add.i64 %pass, 1
    jmp pass_head

  pass_done:
    print %total
    ret.i64 0
}
