# Fibonacci Sequence Benchmark
# Iterative fibonacci implementation using recursive helper functions
# Mimics the C/C++ iterative approach using functional programming style

fn @fibonacci_iter(i64 %n, i64 %a, i64 %b, i64 %i) -> i64 {
  entry:
    # Base case: if i > n, return b (current fibonacci number)
    %i_gt_n = gt.i64 %i, %n
    br %i_gt_n, return_result, continue_iter

  continue_iter:
    # Fibonacci iteration: temp = a + b; a = b; b = temp;
    %temp = add.i64 %a, %b
    %new_a = add.i64 %b, 0      # new_a = b
    %new_b = add.i64 %temp, 0   # new_b = temp

    # Increment counter: i = i + 1
    %new_i = add.i64 %i, 1

    # Recursive call with updated values
    %result = call @fibonacci_iter(%n, %new_a, %new_b, %new_i)
    ret.i64 %result

  return_result:
    ret.i64 %b
}

fn @fibonacci_iterative(i64 %n) -> i64 {
  entry:
    # Base cases - same as C/C++ version
    %is_zero = eq.i64 %n, 0
    br %is_zero, return_zero, check_one

  return_zero:
    ret.i64 0

  check_one:
    %is_one = eq.i64 %n, 1
    br %is_one, return_one, start_iteration

  return_one:
    ret.i64 1

  start_iteration:
    # Start iteration with initial values: a=0, b=1, i=2
    %result = call @fibonacci_iter(%n, 0, 1, 2)
    ret.i64 %result
}

fn @main() -> i64 {
  entry:
    # Print header marker
    call @print_i64(123456789)

    # Compute and print fibonacci values using iterative algorithm
    %fib10 = call @fibonacci_iterative(10)
    call @print_i64(%fib10)

    %fib20 = call @fibonacci_iterative(20)
    call @print_i64(%fib20)

    %fib30 = call @fibonacci_iterative(30)
    call @print_i64(%fib30)

    %fib35 = call @fibonacci_iterative(35)
    call @print_i64(%fib35)

    %acc = add.i64 0, 0
    %sweep = add.i64 0, 0
    jmp sweep_head

  sweep_head:
    %sweep_more = lt.i64 %sweep, 200000
    br %sweep_more, sweep_body, sweep_done

  sweep_body:
    %arg = rem.i64 %sweep, 90
    %value = call @fibonacci_iterative(%arg)
    %acc = add.i64 %acc, %value
    %sweep = add.i64 %sweep, 1
    jmp sweep_head

  sweep_done:
    call @print_i64(%acc)

    # Print footer marker
    call @print_i64(987654321)

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
