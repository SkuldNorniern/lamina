# 2D Matrix Multiplication Benchmark (NumPy matmul equivalent)
# Same algorithm as 2Dmatmul.c: C = A @ B for A (n_rows x k_dim), B (k_dim x n_cols).
# Matrix elements come from a deterministic pattern instead of being stored.

fn @get_matrix_a_element(i64 %i, i64 %k) -> i64 {
  entry:
    %product = mul.i64 %i, %k
    %result = add.i64 %product, 1
    ret.i64 %result
}

fn @get_matrix_b_element(i64 %k, i64 %j) -> i64 {
  entry:
    %product = mul.i64 %k, %j
    %result = add.i64 %product, 1
    ret.i64 %result
}

fn @compute_matrix_cell(i64 %i, i64 %j, i64 %k_dim) -> i64 {
  entry:
    %sum = add.i64 0, 0
    %k = add.i64 0, 0
    jmp k_loop

  k_loop:
    %k_done = ge.i64 %k, %k_dim
    br %k_done, cell_done, k_body

  k_body:
    %a_elem = call @get_matrix_a_element(%i, %k)
    %b_elem = call @get_matrix_b_element(%k, %j)
    %product = mul.i64 %a_elem, %b_elem
    %sum = add.i64 %sum, %product
    %k = add.i64 %k, 1
    jmp k_loop

  cell_done:
    ret.i64 %sum
}

fn @matmul_2d(i64 %n_rows, i64 %k_dim, i64 %n_cols) -> i64 {
  entry:
    print %n_rows
    print %k_dim
    print %n_cols

    %result_size = mul.i64 %n_rows, %n_cols
    %total_sum = add.i64 0, 0
    %i = add.i64 0, 0
    jmp i_loop

  i_loop:
    %i_done = ge.i64 %i, %n_rows
    br %i_done, matmul_done, i_body

  i_body:
    %j = add.i64 0, 0
    jmp j_loop

  j_loop:
    %j_done = ge.i64 %j, %n_cols
    br %j_done, next_i, j_body

  j_body:
    %cell_result = call @compute_matrix_cell(%i, %j, %k_dim)
    %total_sum = add.i64 %total_sum, %cell_result
    %j = add.i64 %j, 1
    jmp j_loop

  next_i:
    %i = add.i64 %i, 1
    jmp i_loop

  matmul_done:
    print %total_sum
    %ops_per_cell = mul.i64 %k_dim, 2
    %total_ops = mul.i64 %result_size, %ops_per_cell
    print %total_ops
    ret.i64 %total_sum
}

@export
fn @main() -> i64 {
  entry:
    %n_rows = add.i64 256, 0
    %k_dim = add.i64 256, 0
    %n_cols = add.i64 256, 0

    %header = add.i64 123456789, 0
    print %header

    %result = call @matmul_2d(%n_rows, %k_dim, %n_cols)

    %status = add.i64 987654323, 0
    print %status

    ret.i64 0
}
