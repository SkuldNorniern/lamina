# 2D Matrix Multiplication Benchmark (NumPy matmul equivalent)
# Same algorithm as 2Dmatmul.c: C = A @ B for A (n_rows x k_dim), B (k_dim x n_cols).
# Matrix elements come from a hashed index so the k-sum has no closed form.

fn @mix(i64 %x) -> i64 {
  entry:
    %m = mul.i64 %x, 1103515245
    %m1 = add.i64 %m, 12345
    %a = and.i64 %m1, 2147483647
    %s = shr.i64 %a, 7
    %b = xor.i64 %a, %s
    %m2 = mul.i64 %b, 1103515245
    %m3 = add.i64 %m2, 12345
    %c = and.i64 %m3, 2147483647
    %t = shr.i64 %c, 11
    %d = xor.i64 %c, %t
    %r = and.i64 %d, 65535
    ret.i64 %r
}

fn @get_matrix_a_element(i64 %i, i64 %k, i64 %k_dim) -> i64 {
  entry:
    %index = mul.i64 %i, %k_dim
    %index1 = add.i64 %index, %k
    %result = call @mix(%index1)
    ret.i64 %result
}

fn @get_matrix_b_element(i64 %k, i64 %j, i64 %n_cols) -> i64 {
  entry:
    %index = mul.i64 %k, %n_cols
    %index1 = add.i64 %index, %j
    %result = call @mix(%index1)
    ret.i64 %result
}

fn @compute_matrix_cell(i64 %i, i64 %j, i64 %k_dim, i64 %n_cols) -> i64 {
  entry:
    %sum = add.i64 0, 0
    %k = add.i64 0, 0
    jmp k_loop

  k_loop:
    %k_done = ge.i64 %k, %k_dim
    br %k_done, cell_done, k_body

  k_body:
    %a_elem = call @get_matrix_a_element(%i, %k, %k_dim)
    %b_elem = call @get_matrix_b_element(%k, %j, %n_cols)
    %product = mul.i64 %a_elem, %b_elem
    %sum = add.i64 %sum, %product
    %k = add.i64 %k, 1
    jmp k_loop

  cell_done:
    ret.i64 %sum
}

fn @matmul_2d(i64 %n_rows, i64 %k_dim, i64 %n_cols) -> i64 {
  entry:
    call @print_i64(%n_rows)
    call @print_i64(%k_dim)
    call @print_i64(%n_cols)

    %result_size = mul.i64 %n_rows, %n_cols
    %total_sum = add.i64 0, 0
    %i = add.i64 0, 0
    jmp i_loop

  i_loop:
    %i_done = ge.i64 %i, %n_rows
    br %i_done, matmul_done, i_body

  i_body:
    %j = add.i64 0, 0
    jmp j_loop

  j_loop:
    %j_done = ge.i64 %j, %n_cols
    br %j_done, next_i, j_body

  j_body:
    %cell_result = call @compute_matrix_cell(%i, %j, %k_dim, %n_cols)
    %total_sum = add.i64 %total_sum, %cell_result
    %j = add.i64 %j, 1
    jmp j_loop

  next_i:
    %i = add.i64 %i, 1
    jmp i_loop

  matmul_done:
    call @print_i64(%total_sum)
    %ops_per_cell = mul.i64 %k_dim, 2
    %total_ops = mul.i64 %result_size, %ops_per_cell
    call @print_i64(%total_ops)
    ret.i64 %total_sum
}

@export
fn @main() -> i64 {
  entry:
    %n_rows = add.i64 512, 0
    %k_dim = add.i64 512, 0
    %n_cols = add.i64 512, 0

    %header = add.i64 123456789, 0
    call @print_i64(%header)

    %result = call @matmul_2d(%n_rows, %k_dim, %n_cols)
    call @print_i64(%result)

    %status = add.i64 987654323, 0
    call @print_i64(%status)

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
