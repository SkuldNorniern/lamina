# Integer arithmetic on locals only. Each iteration runs an LCG step and an
# xor-shift mix, and adds the result to a running sum. The loop body touches no
# memory.

@export
fn @main() -> i64 {
  entry:
    %x = add.i64 12345, 0
    %y = add.i64 0, 0
    %z = add.i64 0, 0
    %i = add.i64 0, 0
    jmp loop_head

  loop_head:
    %more = lt.i64 %i, 100000000
    br %more, loop_body, loop_done

  loop_body:
    %m = mul.i64 %x, 1103515245
    %m1 = add.i64 %m, 12345
    %x = and.i64 %m1, 2147483647
    %s = shr.i64 %x, 7
    %s2 = shl.i64 %y, 3
    %y1 = xor.i64 %s, %s2
    %y = and.i64 %y1, 2147483647
    %w = xor.i64 %y, %x
    %z = add.i64 %z, %w
    %i = add.i64 %i, 1
    jmp loop_head

  loop_done:
    call @print_i64(%x)
    call @print_i64(%y)
    call @print_i64(%z)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
