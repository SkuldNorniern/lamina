# Call-heavy loop: every iteration runs a chain of calls to two tiny leaf
# functions. The leaves are small enough to inline, so the difference between
# optimization levels is mostly call overhead.

fn @mix(i64 %a, i64 %b) -> i64 {
  entry:
    %t = mul.i64 %a, 31
    %u = add.i64 %t, %b
    %v = xor.i64 %u, %a
    ret.i64 %v
}

fn @step(i64 %a, i64 %b) -> i64 {
  entry:
    %m = call @mix(%a, %b)
    %s = call @mix(%m, 7)
    ret.i64 %s
}

@export
fn @main() -> i64 {
  entry:
    %acc = add.i64 1, 0
    %i = add.i64 0, 0
    jmp loop_head

  loop_head:
    %more = lt.i64 %i, 80000000
    br %more, loop_body, loop_done

  loop_body:
    %acc = call @step(%acc, %i)
    %i = add.i64 %i, 1
    jmp loop_head

  loop_done:
    call @print_i64(%acc)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
