# Segment record with two nested point records. Each point field is reached by
# a getfieldptr on a getfieldptr, and the loop updates all four points in place.

@export
fn @main() -> i64 {
  entry:
    %seg = stackalloc.struct { start: struct { x: i64, y: i64 }, end: struct { x: i64, y: i64 } }
    %sp = getfieldptr.struct { start: struct { x: i64, y: i64 }, end: struct { x: i64, y: i64 } } %seg, 0
    %ep = getfieldptr.struct { start: struct { x: i64, y: i64 }, end: struct { x: i64, y: i64 } } %seg, 1
    %sx = getfieldptr.struct { x: i64, y: i64 } %sp, 0
    %sy = getfieldptr.struct { x: i64, y: i64 } %sp, 1
    %ex = getfieldptr.struct { x: i64, y: i64 } %ep, 0
    %ey = getfieldptr.struct { x: i64, y: i64 } %ep, 1
    store.i64 %sx, 0
    store.i64 %sy, 0
    store.i64 %ex, 3
    store.i64 %ey, 4
    %i = add.i64 0, 0
    %total = add.i64 0, 0
    jmp loop_head

  loop_head:
    %more = lt.i64 %i, 70000000
    br %more, loop_body, loop_done

  loop_body:
    %x0 = load.i64 %sx
    %x1 = add.i64 %x0, 1
    store.i64 %sx, %x1
    %y0 = load.i64 %sy
    %y1 = add.i64 %y0, 2
    store.i64 %sy, %y1
    %ex0 = load.i64 %ex
    %ex1 = sub.i64 %ex0, 1
    store.i64 %ex, %ex1
    %ey0 = load.i64 %ey
    %ey1 = add.i64 %ey0, 3
    store.i64 %ey, %ey1
    %dx = sub.i64 %ex1, %x1
    %dy = sub.i64 %ey1, %y1
    %dx2 = mul.i64 %dx, %dx
    %dy2 = mul.i64 %dy, %dy
    %d = add.i64 %dx2, %dy2
    %t0 = add.i64 %total, %d
    %total = rem.i64 %t0, 1000000007
    %i = add.i64 %i, 1
    jmp loop_head

  loop_done:
    call @print_i64(%total)
    %fsx = load.i64 %sx
    %fsy = load.i64 %sy
    call @print_i64(%fsx)
    call @print_i64(%fsy)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
