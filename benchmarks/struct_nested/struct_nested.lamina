# Segment record with two nested point records. Each point field is reached by
# a getfieldptr on a getfieldptr, and the loop updates all four points in place.

@export
fn @main() -> i64 {
  entry:
    %seg = stackalloc.struct { start: struct { x: i64, y: i64 }, end: struct { x: i64, y: i64 } }
    %sp = getfieldptr %seg, 0
    %ep = getfieldptr %seg, 1
    %sx = getfieldptr %sp, 0
    %sy = getfieldptr %sp, 1
    %ex = getfieldptr %ep, 0
    %ey = getfieldptr %ep, 1
    store.i64 %sx, 0
    store.i64 %sy, 0
    store.i64 %ex, 3
    store.i64 %ey, 4
    %i = add.i64 0, 0
    %total = add.i64 0, 0
    jmp loop_head

  loop_head:
    %more = lt.i64 %i, 8000000
    br %more, loop_body, loop_done

  loop_body:
    %x0 = load.i64 %sx
    %x1 = add.i64 %x0, 1
    store.i64 %sx, %x1
    %y0 = load.i64 %sy
    %y1 = add.i64 %y0, 2
    store.i64 %sy, %y1
    %ex0 = load.i64 %ex
    %ex1 = sub.i64 %ex0, 1
    store.i64 %ex, %ex1
    %ey0 = load.i64 %ey
    %ey1 = add.i64 %ey0, 3
    store.i64 %ey, %ey1
    %dx = sub.i64 %ex1, %x1
    %dy = sub.i64 %ey1, %y1
    %dx2 = mul.i64 %dx, %dx
    %dy2 = mul.i64 %dy, %dy
    %d = add.i64 %dx2, %dy2
    %t0 = add.i64 %total, %d
    %total = rem.i64 %t0, 1000000007
    %i = add.i64 %i, 1
    jmp loop_head

  loop_done:
    print %total
    %fsx = load.i64 %sx
    %fsy = load.i64 %sy
    print %fsx
    print %fsy
    ret.i64 0
}
