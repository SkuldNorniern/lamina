  %w = sext.i8.i128 %v
  %lo = trunc.i128.i64 %w
  call @print_i64(%lo)
  %hs = shr.i128 %w, 64
  %hi = trunc.i128.i64 %hs
  call @print_i64(%hi)
  ret.i64 0
}

