# A callee reads a field through a plain ptr; the layout on getfieldptr sets the offset.

type !Mixed = struct { a: i8, b: i8, c: i64 }

fn @read_b(ptr %p) -> i64 {
entry:
  %bp = getfieldptr.!Mixed %p, 1
  %b = load.i8 %bp
  %w = extend.i8.i64 %b
  ret.i64 %w
}

fn @main() -> i64 {
entry:
  %m = stackalloc.!Mixed
  %ap = getfieldptr.!Mixed %m, 0
  store.i8 %ap, 3
  %bp = getfieldptr.!Mixed %m, 1
  store.i8 %bp, 7
  %cp = getfieldptr.!Mixed %m, 2
  store.i64 %cp, 300
  %b = call @read_b(%m)
  call @print_i64(%b)
  %c = load.i64 %cp
  call @print_i64(%c)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
