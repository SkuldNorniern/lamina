# The loop bound is rewritten inside the body, so the test must see each new value.
fn @main() -> i64 {
  entry:
    %n = add.i64 0, 10
    %i = add.i64 0, 0
    %sum = add.i64 0, 0
    jmp head

  head:
    %more = lt.i64 %i, %n
    br %more, body, done

  body:
    %sum = add.i64 %sum, %i
    %at4 = eq.i64 %i, 4
    br %at4, grow, next

  grow:
    %n = add.i64 %n, 6
    jmp next

  next:
    %i = add.i64 %i, 1
    jmp head

  done:
    call @print_i64(%sum)
    call @print_i64(%n)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
