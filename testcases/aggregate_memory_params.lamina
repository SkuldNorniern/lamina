type !Quad = struct { a: i64, b: i64, c: i64, d: i64 }

fn @sum(!Quad %q) -> i64 {
entry:
  %pa = getfieldptr.!Quad %q, 0
  %a = load.i64 %pa
  %pb = getfieldptr.!Quad %q, 1
  %b = load.i64 %pb
  %pc = getfieldptr.!Quad %q, 2
  %c = load.i64 %pc
  %pd = getfieldptr.!Quad %q, 3
  %d = load.i64 %pd
  %s1 = add.i64 %a, %b
  %s2 = add.i64 %s1, %c
  %s3 = add.i64 %s2, %d
  ret.i64 %s3
}

fn @mix(i64 %lead, !Quad %q, i64 %tail) -> i64 {
entry:
  %pa = getfieldptr.!Quad %q, 0
  %a = load.i64 %pa
  %pd = getfieldptr.!Quad %q, 3
  %d = load.i64 %pd
  %s = add.i64 %lead, %a
  %t = add.i64 %s, %d
  %u = add.i64 %t, %tail
  ret.i64 %u
}

fn @main() -> i64 {
entry:
  %q = stackalloc.!Quad
  %f0 = getfieldptr.!Quad %q, 0
  store.i64 %f0, 1
  %f1 = getfieldptr.!Quad %q, 1
  store.i64 %f1, 2
  %f2 = getfieldptr.!Quad %q, 2
  store.i64 %f2, 3
  %f3 = getfieldptr.!Quad %q, 3
  store.i64 %f3, 4
  %r = call @sum(!Quad %q)
  call @print_i64(%r)
  %m = call @mix(10, !Quad %q, 20)
  call @print_i64(%m)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
