# Counted loops that rotation must keep exact: a multiplying sum and a non-unit stride.
fn @main() -> i64 {
  entry:
    %i = add.i64 0, 0
    %sq = add.i64 0, 0
    jmp sq_head

  sq_head:
    %more = lt.i64 %i, 100
    br %more, sq_body, sq_done

  sq_body:
    %t = mul.i64 %i, %i
    %sq = add.i64 %sq, %t
    %i = add.i64 %i, 1
    jmp sq_head

  sq_done:
    call @print_i64(%sq)
    %k = add.i64 0, 0
    %stride = add.i64 0, 0
    jmp st_head

  st_head:
    %more3 = lt.i64 %k, 100
    br %more3, st_body, st_done

  st_body:
    %stride = add.i64 %stride, %k
    %k = add.i64 %k, 3
    jmp st_head

  st_done:
    call @print_i64(%stride)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
