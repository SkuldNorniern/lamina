# load/store at a stated alignment below the natural one, checked by round trip
fn @main() -> i64 {
  entry:
    %buf = stackalloc.[16 x i8]
    %p = getelem.i8 %buf, 1
    store.i32 %p, 1145258561 align 1
    %v = load.i32 %p align 1
    %q = getelem.i8 %buf, 5
    store.i32 %q, %v align 1
    %r = load.i32 %q align 1
    %e1 = eq.i32 %v, 1145258561
    %e2 = eq.i32 %r, 1145258561
    %z1 = extend.bool.i64 %e1
    %z2 = extend.bool.i64 %e2
    %c1 = add.i64 %z1, 48
    %c2 = add.i64 %z2, 48
    %w1 = writebyte %c1
    %nl1 = writebyte 10
    %w2 = writebyte %c2
    %nl2 = writebyte 10
    ret.i64 0
}
