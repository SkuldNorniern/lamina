# Test I/O with different data types
fn @main() -> i32 {
  entry:
    # Test with different integer types
    %buf8 = stackalloc.i8
    %buf16 = stackalloc.i16
    %buf32 = stackalloc.i32

    # Write different values to buffers
    store.i8 %buf8, -1     # All bits set: 255 as a byte
    store.i16 %buf16, -1   # All bits set: 65535 as a u16
    store.i32 %buf32, 123456

    # Write buffer contents to stdout: a loaded byte, then raw memory of 2 and 4 bytes
    %v8 = load.i8 %buf8
    %w8 = writebyte %v8     # Write 255 to stdout (1 byte)
    %w16 = write %buf16, 2  # Write 65535 to stdout (2 bytes)
    %w32 = write %buf32, 4  # Write 123456 to stdout (4 bytes)

    # Also test with writebyte for comparison
    %wb = writebyte 65      # Write 'A' (65) to stdout

    # Print a summary to ensure consistent output
    %dummy = writebyte 84   # 'T'
    %dummy = writebyte 69   # 'E'
    %dummy = writebyte 83   # 'S'
    %dummy = writebyte 84   # 'T'
    %dummy = writebyte 10   # '\n'

    # Test completed successfully

    ret.i32 0
}
