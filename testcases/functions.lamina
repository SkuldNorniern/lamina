# Test function calls
fn @add_numbers(i64 %a, i64 %b) -> i64 {
  entry:
    %result = add.i64 %a, %b
    ret.i64 %result
}

fn @multiply_by_two(i64 %x) -> i64 {
  entry:
    %result = mul.i64 %x, 2
    ret.i64 %result
}

fn @main() -> i64 {
  entry:
    %sum = call @add_numbers(15, 25)
    %doubled = call @multiply_by_two(%sum)
    call @print_i64(%doubled)  # Should print 80
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
