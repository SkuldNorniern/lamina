# Test function call isolation and parameter passing
fn @add_ten(i64 %x) -> i64 {
  entry:
    %result = add.i64 %x, 10
    ret.i64 %result
}

fn @multiply_by_two(i64 %x) -> i64 {
  entry:
    %result = mul.i64 %x, 2
    ret.i64 %result
}

fn @main() -> i64 {
  entry:
    # Test that function calls don't interfere with each other
    %result1 = call @add_ten(5)        # Should be 15
    %result2 = call @multiply_by_two(8) # Should be 16
    %result3 = call @add_ten(20)       # Should be 30
    %result4 = call @multiply_by_two(12) # Should be 24
    
    call @print_i64(%result1)
    call @print_i64(%result2)
    call @print_i64(%result3)
    call @print_i64(%result4)
    
    # Test chained calls
    %chained = call @add_ten(100)
    %chained = call @multiply_by_two(%chained)  # (100+10)*2 = 220
    
    call @print_i64(%chained)  # Should always be 220
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
