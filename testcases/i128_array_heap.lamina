# i128 elements of a stack array, and a 128-bit value in a heap allocation.
fn @main() -> i64 {
entry:
  %arr = stackalloc.[4 x i128]
  %p0 = getelem.i128 %arr, 0
  %p1 = getelem.i128 %arr, 1
  %p3 = getelem.i128 %arr, 3
  store.i128 %p0, 170141183460469231731687303715884105727
  store.i128 %p1, -5
  %a = add.i128 -5, 1
  store.i128 %p3, %a
  %x = load.i128 %p0
  %y = load.i128 %p1
  %z = load.i128 %p3
  %s = add.i128 %y, %z
  %lo = trunc.i128.i64 %x
  call @print_i64(%lo)
  %hi = shr.i128 %x, 64
  %hl = trunc.i128.i64 %hi
  call @print_i64(%hl)
  %sl = trunc.i128.i64 %s
  call @print_i64(%sl)
  %h = heapalloc.i128
  store.i128 %h, 99999999999999999999999
  %hv = load.i128 %h
  %hvl = trunc.i128.i64 %hv
  call @print_i64(%hvl)
  heapfree %h
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
