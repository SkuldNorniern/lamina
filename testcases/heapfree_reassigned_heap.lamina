# A name first bound to a stack slot and then reassigned to a heap block. The heapfree
# must release the heap block; a stack-keyed fact would skip the free and leak it.
fn @main() -> i64 {
  entry:
    %p = stackalloc.i64
    %p = heapalloc.i64
    store.i64 %p, 7
    %v = load.i64 %p
    heapfree %p
    print %v
    ret.i64 0
}
