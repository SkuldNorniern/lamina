# The loop test calls a function with a side effect, so the test is not copied and
# every evaluation of it, including the last one, must still print.
fn @main() -> i64 {
  entry:
    %i = add.i64 0, 0
    %total = add.i64 0, 0
    jmp head

  head:
    %v = call @next_value(%i)
    %more = lt.i64 %v, 20
    br %more, body, done

  body:
    %total = add.i64 %total, %v
    %i = add.i64 %i, 1
    jmp head

  done:
    call @print_i64(%total)
    call @print_i64(%i)
    ret.i64 0
}

fn @next_value(i64 %x) -> i64 {
  entry:
    call @print_i64(%x)
    %y = mul.i64 %x, 3
    %z = add.i64 %y, 1
    ret.i64 %z
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
