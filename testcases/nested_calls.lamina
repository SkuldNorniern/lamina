# Test nested function calls
fn @add_three(i64 %x) -> i64 {
  entry:
    %result = add.i64 %x, 3
    ret.i64 %result
}

fn @multiply_by_two(i64 %x) -> i64 {
  entry:
    %result = mul.i64 %x, 2
    ret.i64 %result
}

fn @square(i64 %x) -> i64 {
  entry:
    %result = mul.i64 %x, %x
    ret.i64 %result
}

fn @complex_calculation(i64 %x) -> i64 {
  entry:
    %step1 = call @add_three(%x)      # x + 3
    %step2 = call @multiply_by_two(%step1)  # (x + 3) * 2
    %step3 = call @square(%step2)     # ((x + 3) * 2)^2
    ret.i64 %step3
}

fn @main() -> i64 {
  entry:
    %result = call @complex_calculation(5)  # ((5+3)*2)^2 = (8*2)^2 = 16^2 = 256
    call @print_i64(%result)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
