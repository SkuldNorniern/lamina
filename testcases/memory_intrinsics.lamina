@extern
fn @memcpy(ptr %d, ptr %s, i64 %n) -> ptr
@extern
fn @memmove(ptr %d, ptr %s, i64 %n) -> ptr
@extern
fn @memset(ptr %d, i32 %v, i64 %n) -> ptr

fn @main() -> i64 {
entry:
  %buf = stackalloc.[8 x i8]
  %base = getelem.i8 %buf, 0
  call @memset(%base, 65, 8)
  %p3 = getelem.i8 %buf, 3
  store.i8 %p3, 90
  %c3 = load.i8 %p3
  %c3w = extend.i8.i64 %c3
  call @print_i64(%c3w)
  %copy = stackalloc.[8 x i8]
  %cbase = getelem.i8 %copy, 0
  call @memcpy(%cbase, %base, 8)
  %q3 = getelem.i8 %copy, 3
  %d3 = load.i8 %q3
  %d3w = extend.i8.i64 %d3
  call @print_i64(%d3w)
  %q0 = getelem.i8 %copy, 0
  call @memmove(%q0, %q3, 4)
  %e0 = load.i8 %q0
  %e0w = extend.i8.i64 %e0
  call @print_i64(%e0w)
  %q1 = getelem.i8 %copy, 1
  %e1 = load.i8 %q1
  %e1w = extend.i8.i64 %e1
  call @print_i64(%e1w)
  write %cbase, 8, n
  %nl = writebyte 10
  call @print_i64(%n)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
