fn @main() -> i64 {
entry:
  %buf = stackalloc.[8 x i8]
  %base = getelem.i8 %buf, 0
  memset %base, 65, 8
  %p3 = getelem.i8 %buf, 3
  store.i8 %p3, 90
  %c3 = load.i8 %p3
  %c3w = sext.i8.i64 %c3
  print %c3w
  %copy = stackalloc.[8 x i8]
  %cbase = getelem.i8 %copy, 0
  memcpy %cbase, %base, 8
  %q3 = getelem.i8 %copy, 3
  %d3 = load.i8 %q3
  %d3w = sext.i8.i64 %d3
  print %d3w
  %q0 = getelem.i8 %copy, 0
  memmove %q0, %q3, 4
  %e0 = load.i8 %q0
  %e0w = sext.i8.i64 %e0
  print %e0w
  %q1 = getelem.i8 %copy, 1
  %e1 = load.i8 %q1
  %e1w = sext.i8.i64 %e1
  print %e1w
  write %cbase, 8, n
  %nl = writebyte 10
  print %n
  ret.i64 0
}
