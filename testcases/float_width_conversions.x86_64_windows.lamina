@extern
fn @printf(ptr %fmt, ...) -> i32

@extern
fn @fflush(ptr %f) -> i32

global $fmt_g: [4 x i8] = "%g\n"

fn @main() -> i64 {
entry:
  %a = add.f32 1.5, 0.25
  %b = fpcast.f32.f64 %a
  call @print_f64(%b)
  %c = div.f64 1.0, 3.0
  %d = fpcast.f64.f32 %c
  %pv1 = fpcast.f32.f64 %d
  call @print_f64(%pv1)
  %e = fpcast.f32.f64 %d
  call @print_f64(%e)
  %big = add.f64 100000000000000000000000000000000000000000.0, 0.0
  %inf = fpcast.f64.f32 %big
  %pv3 = fpcast.f32.f64 %inf
  call @print_f64(%pv3)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}

fn @print_f64(f64 %x) -> i64 {
entry:
  %big = gt.f64 %x, 1.0e308
  br %big, infinite, finite
infinite:
  %i0 = writebyte 105
  %i1 = writebyte 110
  %i2 = writebyte 102
  %i3 = writebyte 10
  ret.i64 0
finite:
  %p = getelem.i8 $fmt_g, 0
  %r = call @printf(%p, %x)
  %n = inttoptr.i64 0
  %z = call @fflush(%n)
  ret.i64 0
}
