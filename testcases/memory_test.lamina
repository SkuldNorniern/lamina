# Test memory operations and variable isolation
fn @main() -> i64 {
  entry:
    %a = add.i64 100, 0
    %b = add.i64 200, 0
    %c = add.i64 300, 0
    %d = add.i64 400, 0
    %e = add.i64 500, 0
    
    # Test that variables maintain their values
    call @print_i64(%a)  # Should always be 100
    call @print_i64(%b)  # Should always be 200
    call @print_i64(%c)  # Should always be 300
    call @print_i64(%d)  # Should always be 400
    call @print_i64(%e)  # Should always be 500
    
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
