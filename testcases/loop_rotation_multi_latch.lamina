# Two back edges reach the same test: a continue path and the normal end of the body.
fn @main() -> i64 {
  entry:
    %i = add.i64 0, 0
    %sum = add.i64 0, 0
    jmp head

  head:
    %more = lt.i64 %i, 15
    br %more, body, done

  body:
    %half = div.i64 %i, 2
    %back = mul.i64 %half, 2
    %even = eq.i64 %back, %i
    br %even, skip, work

  skip:
    %i = add.i64 %i, 1
    jmp head

  work:
    %sum = add.i64 %sum, %i
    %i = add.i64 %i, 1
    jmp head

  done:
    call @print_i64(%sum)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
