@weak
@align(64)
fn @weak_add(i64 %a, i64 %b) -> i64 {
entry:
  %s = add.i64 %a, %b
  ret.i64 %s
}

@section(".text.custom")
@align(16)
fn @placed(i64 %x) -> i64 {
entry:
  %y = mul.i64 %x, 3
  ret.i64 %y
}

@hot
@align(8)
fn @hot_fn() -> i64 {
entry:
  ret.i64 7
}

fn @main() -> i64 {
entry:
  %a = call @weak_add(40, 2)
  call @print_i64(%a)
  %b = call @placed(5)
  call @print_i64(%b)
  %c = call @hot_fn()
  call @print_i64(%c)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
