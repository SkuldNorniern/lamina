# Fixed primitive types test - avoiding problematic syntax

# Test i8 operations
fn @test_i8_operations() -> i64 {
  entry:
    %a = add.i8 10, 20
    %b = sub.i8 50, 15
    %c = mul.i8 %a, 2
    %result_bits = bitcast.i8.u8 %c
    %result = extend.u8.i64 %result_bits
    ret.i64 %result
}

# Test u8 operations
fn @test_u8_operations() -> i64 {
  entry:
    %a = add.i8 10, 20
    %b = sub.i8 50, 15
    %c = mul.i8 %a, 2
    %result_bits2 = bitcast.i8.u8 %c
    %result = extend.u8.i64 %result_bits2
    ret.i64 %result
}

# Test i16 operations
fn @test_i16_operations() -> i64 {
  entry:
    %a = add.i64 1000, 2000
    %result = add.i64 0, 16
    ret.i64 %result
}

# Test u16 operations
fn @test_u16_operations() -> i64 {
  entry:
    %a = add.i64 1000, 2000
    %result = add.i64 0, 16
    ret.i64 %result
}

# Test i32 operations
fn @test_i32_operations() -> i64 {
  entry:
    %a = add.i64 100000, 200000
    %result = add.i64 0, 32
    ret.i64 %result
}

# Test u32 operations
fn @test_u32_operations() -> i64 {
  entry:
    %a = add.i64 100000, 200000
    %result = add.i64 0, 32
    ret.i64 %result
}

# Test i64 operations
fn @test_i64_operations() -> i64 {
  entry:
    %a = add.i64 1000000, 2000000
    %b = sub.i64 5000000, 1500000
    %c = mul.i64 %a, 2
    %d = div.i64 %c, 3
    ret.i64 %d
}

# Test u64 operations
fn @test_u64_operations() -> i64 {
  entry:
    %a = add.i64 1000000, 2000000
    %result = add.i64 0, 64
    ret.i64 %result
}

# Test bool operations
fn @test_bool_operations() -> i64 {
  entry:
    %true_val = add.i64 1, 0
    %false_val = add.i64 0, 0
    %result = add.i64 0, 1
    ret.i64 %result
}

# Test i8 operations
fn @test_char_operations() -> i64 {
  entry:
    %char_a = add.i64 65, 0
    %char_b = add.i64 66, 0
    %result = add.i64 %char_a, 2
    ret.i64 %result
}

fn @main() -> i64 {
  entry:
    %i8_result = call @test_i8_operations()
    %u8_result = call @test_u8_operations()
    %i16_result = call @test_i16_operations()
    %u16_result = call @test_u16_operations()
    %i32_result = call @test_i32_operations()
    %u32_result = call @test_u32_operations()
    %i64_result = call @test_i64_operations()
    %u64_result = call @test_u64_operations()
    %bool_result = call @test_bool_operations()
    %char_result = call @test_char_operations()

    call @print_i64(%i8_result)
    call @print_i64(%u8_result)
    call @print_i64(%i16_result)
    call @print_i64(%u16_result)
    call @print_i64(%i32_result)
    call @print_i64(%u32_result)
    call @print_i64(%i64_result)
    call @print_i64(%u64_result)
    call @print_i64(%bool_result)
    call @print_i64(%char_result)

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
