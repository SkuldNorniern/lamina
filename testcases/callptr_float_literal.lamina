global $slot: i64 = 0

fn @bits32(f32 %p) -> i64 {
entry:
  %b = bitcast.f32.i32 %p
  %w = extend.i32.i64 %b
  ret.i64 %w
}

fn @bits64(f64 %p) -> i64 {
entry:
  %b = bitcast.f64.i64 %p
  ret.i64 %b
}

fn @mixed(f32 %a, i64 %n, f64 %d) -> i64 {
entry:
  %ab = bitcast.f32.i32 %a
  %aw = extend.i32.i64 %ab
  %db = bitcast.f64.i64 %d
  call @print_i64(%aw)
  call @print_i64(%n)
  call @print_i64(%db)
  ret.i64 0
}

fn @nullary() -> i64 {
entry:
  ret.i64 7
}

fn @report(f32 %a) -> void {
entry:
  %b = bitcast.f32.i32 %a
  %w = extend.i32.i64 %b
  store.i64 $slot, %w
  ret.void
}

fn @main() -> i64 {
entry:
  %p1 = funcaddr @bits32
  %a = callptr.i64 %p1(f32 11.5)
  call @print_i64(%a)
  %v = add.f32 11.5, 0.0
  %b = callptr.i64 %p1(f32 %v)
  call @print_i64(%b)
  %p2 = funcaddr @bits64
  %c = callptr.i64 %p2(f64 11.5)
  call @print_i64(%c)
  %w = add.f64 11.5, 0.0
  %d = callptr.i64 %p2(f64 %w)
  call @print_i64(%d)
  %p3 = funcaddr @mixed
  %e = callptr.i64 %p3(f32 11.5, i64 42, f64 2.5)
  %p0 = funcaddr @nullary
  %g = callptr.i64 %p0()
  call @print_i64(%g)
  %p4 = funcaddr @report
  callptr.void %p4(f32 11.5)
  %sv = load.i64 $slot
  call @print_i64(%sv)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
