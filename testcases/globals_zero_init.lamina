global $acc: i64
global $flag: i8

fn @main() -> i64 {
entry:
 %z = load.i64 $acc
 call @print_i64(%z)
 store.i64 $acc, 7
 %f0 = load.i8 $flag
 %f0w = zext.i8.i64 %f0
 call @print_i64(%f0w)
 store.i8 $flag, 200
 %f1 = load.i8 $flag
 %f1w = zext.i8.i64 %f1
 %acc = load.i64 $acc
 %sum = add.i64 %acc, %f1w
 call @print_i64(%sum)
 ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
