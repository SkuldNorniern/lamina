global $scale: f64 = 2.5
global $half: f32 = 0.5

fn @main() -> i64 {
entry:
 %s = load.f64 $scale
 %t = mul.f64 %s, 4.0
 %ti = fptoint.f64.i64 %t
 call @print_i64(%ti)
 %h = load.f32 $half
 %h2 = mul.f32 %h, 8.0
 %bits = bitcast.f32.i32 %h2
 %wide = extend.i32.i64 %bits
 call @print_i64(%wide)
 ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
