@extern
fn @printf(ptr %fmt, ...) -> i32

@extern
fn @fflush(ptr %f) -> i32

global $fmt_g: [4 x i8] = "%g\n"

type !Pair = struct { a: i32, b: i64 }
global $pair: !Pair = {7, 9}
global $mixed: struct { k: i8, v: f64 } = {65, 2.5}

fn @main() -> i64 {
entry:
  %f0 = getfieldptr $pair, 0
  %a = load.i32 %f0
  %aw = sext.i32.i64 %a
  call @print_i64(%aw)
  %f1 = getfieldptr $pair, 1
  %b = load.i64 %f1
  call @print_i64(%b)
  %g0 = getfieldptr $mixed, 0
  %k = load.i8 %g0
  %kw = sext.i8.i64 %k
  call @print_i64(%kw)
  %g1 = getfieldptr $mixed, 1
  %v = load.f64 %g1
  call @print_f64(%v)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}

fn @print_f64(f64 %x) -> i64 {
entry:
  %p = getelem.i8 $fmt_g, 0
  %r = call @printf(%p, %x)
  %n = inttoptr.i64 0
  %z = call @fflush(%n)
  ret.i64 0
}
