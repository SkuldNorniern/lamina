# Nested loops whose inner test depends on the outer induction variable, with an
# early exit out of the inner body.
fn @main() -> i64 {
  entry:
    %i = add.i64 0, 0
    %acc = add.i64 0, 0
    jmp outer_head

  outer_head:
    %outer_more = lt.i64 %i, 6
    br %outer_more, outer_body, outer_done

  outer_body:
    %j = add.i64 0, 0
    jmp inner_head

  inner_head:
    %inner_more = lt.i64 %j, %i
    br %inner_more, inner_body, outer_next

  inner_body:
    %limit = eq.i64 %j, 4
    br %limit, outer_next, inner_step

  inner_step:
    %prod = mul.i64 %i, %j
    %acc = add.i64 %acc, %prod
    %j = add.i64 %j, 1
    jmp inner_head

  outer_next:
    %i = add.i64 %i, 1
    jmp outer_head

  outer_done:
    call @print_i64(%acc)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
