# Comprehensive test for type conversions between all supported types

# ===== TYPE CONVERSION OPERATIONS =====

# Test i8 conversions
fn @test_i8_conversions() -> i64 {
  entry:
    %val_i8 = add.i8 100, 0

    # Convert i8 to all other types
    %to_u8 = bitcast.i8.u8 %val_i8
    %to_i16_bits = bitcast.i8.u8 %val_i8
    %to_i16 = extend.u8.i16 %to_i16_bits
    %to_u16_bits = bitcast.i8.u8 %val_i8
    %to_u16 = extend.u8.u16 %to_u16_bits
    %to_i32_bits = bitcast.i8.u8 %val_i8
    %to_i32 = extend.u8.i32 %to_i32_bits
    %to_u32_bits = bitcast.i8.u8 %val_i8
    %to_u32 = extend.u8.u32 %to_u32_bits
    %to_i64_bits = bitcast.i8.u8 %val_i8
    %to_i64 = extend.u8.i64 %to_i64_bits
    %to_u64_bits = bitcast.i8.u8 %val_i8
    %to_u64 = extend.u8.u64 %to_u64_bits
    %to_bool = ne.i8 %val_i8, 0  # Convert to bool (true if non-zero)
    %to_char = add.i8 0, %val_i8  # Convert to i8

    # Convert back to i64 for verification
    %u8_i64 = extend.u8.i64 %to_u8
    %i16_i64_bits = bitcast.i16.u16 %to_i16
    %i16_i64 = extend.u16.i64 %i16_i64_bits
    %u16_i64 = extend.u16.i64 %to_u16
    %i32_i64_bits = bitcast.i32.u32 %to_i32
    %i32_i64 = extend.u32.i64 %i32_i64_bits
    %u32_i64 = extend.u32.i64 %to_u32
    %bool_i64 = extend.bool.i64 %to_bool
    %char_i64_bits = bitcast.i8.u8 %to_char
    %char_i64 = extend.u8.i64 %char_i64_bits

    # Sum all converted values
    %sum1 = add.i64 %u8_i64, %i16_i64
    %sum2 = add.i64 %sum1, %u16_i64
    %sum3 = add.i64 %sum2, %i32_i64
    %sum4 = add.i64 %sum3, %u32_i64
    %sum5 = add.i64 %sum4, %to_i64
    %sum6 = add.i64 %sum5, %to_u64
    %sum7 = add.i64 %sum6, %bool_i64
    %result = add.i64 %sum7, %char_i64

    ret.i64 %result
}

# Test u8 conversions
fn @test_u8_conversions() -> i64 {
  entry:
    %val_u8 = add.u8 200, 0

    # Convert u8 to all other types
    %to_i8 = add.i8 0, %val_u8  # Truncating conversion
    %to_i16 = extend.u8.i16 %val_u8
    %to_u16 = extend.u8.u16 %val_u8
    %to_i32 = extend.u8.i32 %val_u8
    %to_u32 = extend.u8.u32 %val_u8
    %to_i64 = extend.u8.i64 %val_u8
    %to_u64 = extend.u8.u64 %val_u8
    %to_bool = ne.u8 %val_u8, 0
    %to_char = add.i8 0, %val_u8

    # Convert back to i64 for verification
    %i8_i64_bits = bitcast.i8.u8 %to_i8
    %i8_i64 = extend.u8.i64 %i8_i64_bits
    %i16_i64_bits2 = bitcast.i16.u16 %to_i16
    %i16_i64 = extend.u16.i64 %i16_i64_bits2
    %u16_i64 = extend.u16.i64 %to_u16
    %i32_i64_bits2 = bitcast.i32.u32 %to_i32
    %i32_i64 = extend.u32.i64 %i32_i64_bits2
    %u32_i64 = extend.u32.i64 %to_u32
    %bool_i64 = extend.bool.i64 %to_bool
    %char_i64_bits2 = bitcast.i8.u8 %to_char
    %char_i64 = extend.u8.i64 %char_i64_bits2

    # Sum all converted values
    %sum1 = add.i64 %i8_i64, %i16_i64
    %sum2 = add.i64 %sum1, %u16_i64
    %sum3 = add.i64 %sum2, %i32_i64
    %sum4 = add.i64 %sum3, %u32_i64
    %sum5 = add.i64 %sum4, %to_i64
    %sum6 = add.i64 %sum5, %to_u64
    %sum7 = add.i64 %sum6, %bool_i64
    %result = add.i64 %sum7, %char_i64

    ret.i64 %result
}

# Test i16 conversions
fn @test_i16_conversions() -> i64 {
  entry:
    %val_i16 = add.i16 30000, 0

    # Convert i16 to all other types
    %to_i8 = trunc.i16.i8 %val_i16   # Truncating
    %to_u8 = trunc.i16.u8 %val_i16   # Truncating
    %to_u16 = bitcast.i16.u16 %val_i16
    %to_i32_bits2 = bitcast.i16.u16 %val_i16
    %to_i32 = extend.u16.i32 %to_i32_bits2
    %to_u32_bits2 = bitcast.i16.u16 %val_i16
    %to_u32 = extend.u16.u32 %to_u32_bits2
    %to_i64_bits2 = bitcast.i16.u16 %val_i16
    %to_i64 = extend.u16.i64 %to_i64_bits2
    %to_u64_bits2 = bitcast.i16.u16 %val_i16
    %to_u64 = extend.u16.u64 %to_u64_bits2
    %to_bool = ne.i16 %val_i16, 0
    %to_char = trunc.i16.i8 %val_i16  # Truncating

    # Convert back to i64 for verification
    %i8_i64_bits2 = bitcast.i8.u8 %to_i8
    %i8_i64 = extend.u8.i64 %i8_i64_bits2
    %u8_i64 = extend.u8.i64 %to_u8
    %u16_i64 = extend.u16.i64 %to_u16
    %i32_i64_bits3 = bitcast.i32.u32 %to_i32
    %i32_i64 = extend.u32.i64 %i32_i64_bits3
    %u32_i64 = extend.u32.i64 %to_u32
    %bool_i64 = extend.bool.i64 %to_bool
    %char_i64_bits3 = bitcast.i8.u8 %to_char
    %char_i64 = extend.u8.i64 %char_i64_bits3

    # Sum all converted values
    %sum1 = add.i64 %i8_i64, %u8_i64
    %sum2 = add.i64 %sum1, %u16_i64
    %sum3 = add.i64 %sum2, %i32_i64
    %sum4 = add.i64 %sum3, %u32_i64
    %sum5 = add.i64 %sum4, %to_i64
    %sum6 = add.i64 %sum5, %to_u64
    %sum7 = add.i64 %sum6, %bool_i64
    %result = add.i64 %sum7, %char_i64

    ret.i64 %result
}

# Test u16 conversions
fn @test_u16_conversions() -> i64 {
  entry:
    %val_u16 = add.u16 50000, 0

    # Convert u16 to all other types
    %to_i8 = trunc.u16.i8 %val_u16
    %to_u8 = trunc.u16.u8 %val_u16
    %to_i16 = add.i16 0, %val_u16 # Truncating
    %to_i32 = extend.u16.i32 %val_u16
    %to_u32 = extend.u16.u32 %val_u16
    %to_i64 = extend.u16.i64 %val_u16
    %to_u64 = extend.u16.u64 %val_u16
    %to_bool = ne.u16 %val_u16, 0
    %to_char = trunc.u16.i8 %val_u16

    # Convert back to i64 for verification
    %i8_i64_bits3 = bitcast.i8.u8 %to_i8
    %i8_i64 = extend.u8.i64 %i8_i64_bits3
    %u8_i64 = extend.u8.i64 %to_u8
    %i16_i64_bits3 = bitcast.i16.u16 %to_i16
    %i16_i64 = extend.u16.i64 %i16_i64_bits3
    %i32_i64_bits4 = bitcast.i32.u32 %to_i32
    %i32_i64 = extend.u32.i64 %i32_i64_bits4
    %u32_i64 = extend.u32.i64 %to_u32
    %bool_i64 = extend.bool.i64 %to_bool
    %char_i64_bits4 = bitcast.i8.u8 %to_char
    %char_i64 = extend.u8.i64 %char_i64_bits4

    # Sum all converted values
    %sum1 = add.i64 %i8_i64, %u8_i64
    %sum2 = add.i64 %sum1, %i16_i64
    %sum3 = add.i64 %sum2, %i32_i64
    %sum4 = add.i64 %sum3, %u32_i64
    %sum5 = add.i64 %sum4, %to_i64
    %sum6 = add.i64 %sum5, %to_u64
    %sum7 = add.i64 %sum6, %bool_i64
    %result = add.i64 %sum7, %char_i64

    ret.i64 %result
}

# Test i32 conversions
fn @test_i32_conversions() -> i64 {
  entry:
    %val_i32 = add.i32 100000, 0

    # Convert i32 to all other types
    %to_i8 = trunc.i32.i8 %val_i32   # Truncating
    %to_u8 = trunc.i32.u8 %val_i32   # Truncating
    %to_i16 = trunc.i32.i16 %val_i32 # Truncating
    %to_u16 = trunc.i32.u16 %val_i32 # Truncating
    %to_u32 = bitcast.i32.u32 %val_i32
    %to_i64_bits3 = bitcast.i32.u32 %val_i32
    %to_i64 = extend.u32.i64 %to_i64_bits3
    %to_u64_bits3 = bitcast.i32.u32 %val_i32
    %to_u64 = extend.u32.u64 %to_u64_bits3
    %to_bool = ne.i32 %val_i32, 0
    %to_char = trunc.i32.i8 %val_i32  # Truncating

    # Convert back to i64 for verification
    %i8_i64_bits4 = bitcast.i8.u8 %to_i8
    %i8_i64 = extend.u8.i64 %i8_i64_bits4
    %u8_i64 = extend.u8.i64 %to_u8
    %i16_i64_bits4 = bitcast.i16.u16 %to_i16
    %i16_i64 = extend.u16.i64 %i16_i64_bits4
    %u16_i64 = extend.u16.i64 %to_u16
    %u32_i64 = extend.u32.i64 %to_u32
    %bool_i64 = extend.bool.i64 %to_bool
    %char_i64_bits5 = bitcast.i8.u8 %to_char
    %char_i64 = extend.u8.i64 %char_i64_bits5

    # Sum all converted values
    %sum1 = add.i64 %i8_i64, %u8_i64
    %sum2 = add.i64 %sum1, %i16_i64
    %sum3 = add.i64 %sum2, %u16_i64
    %sum4 = add.i64 %sum3, %u32_i64
    %sum5 = add.i64 %sum4, %to_i64
    %sum6 = add.i64 %sum5, %to_u64
    %sum7 = add.i64 %sum6, %bool_i64
    %result = add.i64 %sum7, %char_i64

    ret.i64 %result
}

# Test u32 conversions
fn @test_u32_conversions() -> i64 {
  entry:
    %val_u32 = add.u32 2000000000, 0

    # Convert u32 to all other types
    %to_i8 = trunc.u32.i8 %val_u32   # Truncating
    %to_u8 = trunc.u32.u8 %val_u32   # Truncating
    %to_i16 = trunc.u32.i16 %val_u32 # Truncating
    %to_u16 = trunc.u32.u16 %val_u32 # Truncating
    %to_i32 = add.i32 0, %val_u32 # Truncating
    %to_i64 = extend.u32.i64 %val_u32
    %to_u64 = extend.u32.u64 %val_u32
    %to_bool = ne.u32 %val_u32, 0
    %to_char = trunc.u32.i8 %val_u32  # Truncating

    # Convert back to i64 for verification
    %i8_i64_bits5 = bitcast.i8.u8 %to_i8
    %i8_i64 = extend.u8.i64 %i8_i64_bits5
    %u8_i64 = extend.u8.i64 %to_u8
    %i16_i64_bits5 = bitcast.i16.u16 %to_i16
    %i16_i64 = extend.u16.i64 %i16_i64_bits5
    %u16_i64 = extend.u16.i64 %to_u16
    %i32_i64_bits5 = bitcast.i32.u32 %to_i32
    %i32_i64 = extend.u32.i64 %i32_i64_bits5
    %bool_i64 = extend.bool.i64 %to_bool
    %char_i64_bits6 = bitcast.i8.u8 %to_char
    %char_i64 = extend.u8.i64 %char_i64_bits6

    # Sum all converted values
    %sum1 = add.i64 %i8_i64, %u8_i64
    %sum2 = add.i64 %sum1, %i16_i64
    %sum3 = add.i64 %sum2, %u16_i64
    %sum4 = add.i64 %sum3, %i32_i64
    %sum5 = add.i64 %sum4, %to_i64
    %sum6 = add.i64 %sum5, %to_u64
    %sum7 = add.i64 %sum6, %bool_i64
    %result = add.i64 %sum7, %char_i64

    ret.i64 %result
}

# Test i64 conversions
fn @test_i64_conversions() -> i64 {
  entry:
    %val_i64 = add.i64 5000000000, 0

    # Convert i64 to all other types (truncating where necessary)
    %to_i8 = trunc.i64.i8 %val_i64
    %to_u8 = trunc.i64.u8 %val_i64
    %to_i16 = trunc.i64.i16 %val_i64
    %to_u16 = trunc.i64.u16 %val_i64
    %to_i32 = trunc.i64.i32 %val_i64
    %to_u32 = trunc.i64.u32 %val_i64
    %to_u64 = add.u64 0, %val_i64  # Truncating
    %to_bool = ne.i64 %val_i64, 0
    %to_char = trunc.i64.i8 %val_i64

    # Convert back to i64 for verification
    %i8_i64_bits6 = bitcast.i8.u8 %to_i8
    %i8_i64 = extend.u8.i64 %i8_i64_bits6
    %u8_i64 = extend.u8.i64 %to_u8
    %i16_i64_bits6 = bitcast.i16.u16 %to_i16
    %i16_i64 = extend.u16.i64 %i16_i64_bits6
    %u16_i64 = extend.u16.i64 %to_u16
    %i32_i64_bits6 = bitcast.i32.u32 %to_i32
    %i32_i64 = extend.u32.i64 %i32_i64_bits6
    %u32_i64 = extend.u32.i64 %to_u32
    %bool_i64 = extend.bool.i64 %to_bool
    %char_i64_bits7 = bitcast.i8.u8 %to_char
    %char_i64 = extend.u8.i64 %char_i64_bits7

    # Sum all converted values
    %sum1 = add.i64 %i8_i64, %u8_i64
    %sum2 = add.i64 %sum1, %i16_i64
    %sum3 = add.i64 %sum2, %u16_i64
    %sum4 = add.i64 %sum3, %i32_i64
    %sum5 = add.i64 %sum4, %u32_i64
    %sum6 = add.i64 %sum5, %to_u64
    %sum7 = add.i64 %sum6, %bool_i64
    %result = add.i64 %sum7, %char_i64

    ret.i64 %result
}

# Test u64 conversions
fn @test_u64_conversions() -> i64 {
  entry:
    %val_u64 = add.u64 10000000000, 0

    # Convert u64 to all other types (truncating)
    %to_i8 = trunc.u64.i8 %val_u64
    %to_u8 = trunc.u64.u8 %val_u64
    %to_i16 = trunc.u64.i16 %val_u64
    %to_u16 = trunc.u64.u16 %val_u64
    %to_i32 = trunc.u64.i32 %val_u64
    %to_u32 = trunc.u64.u32 %val_u64
    %to_i64 = add.i64 0, %val_u64  # Truncating
    %to_bool = ne.u64 %val_u64, 0
    %to_char = trunc.u64.i8 %val_u64

    # Convert back to i64 for verification
    %i8_i64_bits7 = bitcast.i8.u8 %to_i8
    %i8_i64 = extend.u8.i64 %i8_i64_bits7
    %u8_i64 = extend.u8.i64 %to_u8
    %i16_i64_bits7 = bitcast.i16.u16 %to_i16
    %i16_i64 = extend.u16.i64 %i16_i64_bits7
    %u16_i64 = extend.u16.i64 %to_u16
    %i32_i64_bits7 = bitcast.i32.u32 %to_i32
    %i32_i64 = extend.u32.i64 %i32_i64_bits7
    %u32_i64 = extend.u32.i64 %to_u32
    %bool_i64 = extend.bool.i64 %to_bool
    %char_i64_bits8 = bitcast.i8.u8 %to_char
    %char_i64 = extend.u8.i64 %char_i64_bits8

    # Sum all converted values
    %sum1 = add.i64 %i8_i64, %u8_i64
    %sum2 = add.i64 %sum1, %i16_i64
    %sum3 = add.i64 %sum2, %u16_i64
    %sum4 = add.i64 %sum3, %i32_i64
    %sum5 = add.i64 %sum4, %u32_i64
    %sum6 = add.i64 %sum5, %to_i64
    %sum7 = add.i64 %sum6, %bool_i64
    %result = add.i64 %sum7, %char_i64

    ret.i64 %result
}

# Test bool conversions
fn @test_bool_conversions() -> i64 {
  entry:
    %true_val = add.bool true, false
    %false_val = add.bool false, false

    # Convert bool to all other types
    %true_i8 = extend.bool.i8 %true_val
    %true_u8 = extend.bool.u8 %true_val
    %true_i16 = extend.bool.i16 %true_val
    %true_u16 = extend.bool.u16 %true_val
    %true_i32 = extend.bool.i32 %true_val
    %true_u32 = extend.bool.u32 %true_val
    %true_i64 = extend.bool.i64 %true_val
    %true_u64 = extend.bool.u64 %true_val
    %true_char = extend.bool.i8 %true_val

    %false_i8 = extend.bool.i8 %false_val
    %false_u8 = extend.bool.u8 %false_val
    %false_i16 = extend.bool.i16 %false_val
    %false_u16 = extend.bool.u16 %false_val
    %false_i32 = extend.bool.i32 %false_val
    %false_u32 = extend.bool.u32 %false_val
    %false_i64 = extend.bool.i64 %false_val
    %false_u64 = extend.bool.u64 %false_val
    %false_char = extend.bool.i8 %false_val

    %true_i8_wide_bits = bitcast.i8.u8 %true_i8
    %true_i8_wide = extend.u8.i64 %true_i8_wide_bits
    %true_u8_wide = extend.u8.i64 %true_u8
    %true_i16_wide_bits = bitcast.i16.u16 %true_i16
    %true_i16_wide = extend.u16.i64 %true_i16_wide_bits
    %true_u16_wide = extend.u16.i64 %true_u16
    %true_i32_wide_bits = bitcast.i32.u32 %true_i32
    %true_i32_wide = extend.u32.i64 %true_i32_wide_bits
    %true_u32_wide = extend.u32.i64 %true_u32
    %true_char_wide_bits = bitcast.i8.u8 %true_char
    %true_char_wide = extend.u8.i64 %true_char_wide_bits
    %false_i8_wide_bits = bitcast.i8.u8 %false_i8
    %false_i8_wide = extend.u8.i64 %false_i8_wide_bits
    %false_u8_wide = extend.u8.i64 %false_u8
    %false_i16_wide_bits = bitcast.i16.u16 %false_i16
    %false_i16_wide = extend.u16.i64 %false_i16_wide_bits
    %false_u16_wide = extend.u16.i64 %false_u16
    %false_i32_wide_bits = bitcast.i32.u32 %false_i32
    %false_i32_wide = extend.u32.i64 %false_i32_wide_bits
    %false_u32_wide = extend.u32.i64 %false_u32
    %false_char_wide_bits = bitcast.i8.u8 %false_char
    %false_char_wide = extend.u8.i64 %false_char_wide_bits
    # Sum all true conversions
    %t_sum1 = add.i64 %true_i8_wide, %true_u8_wide
    %t_sum2 = add.i64 %t_sum1, %true_i16_wide
    %t_sum3 = add.i64 %t_sum2, %true_u16_wide
    %t_sum4 = add.i64 %t_sum3, %true_i32_wide
    %t_sum5 = add.i64 %t_sum4, %true_u32_wide
    %t_sum6 = add.i64 %t_sum5, %true_i64
    %t_sum7 = add.i64 %t_sum6, %true_u64
    %true_total = add.i64 %t_sum7, %true_char_wide

    # Sum all false conversions (should be 0)
    %f_sum1 = add.i64 %false_i8_wide, %false_u8_wide
    %f_sum2 = add.i64 %f_sum1, %false_i16_wide
    %f_sum3 = add.i64 %f_sum2, %false_u16_wide
    %f_sum4 = add.i64 %f_sum3, %false_i32_wide
    %f_sum5 = add.i64 %f_sum4, %false_u32_wide
    %f_sum6 = add.i64 %f_sum5, %false_i64
    %f_sum7 = add.i64 %f_sum6, %false_u64
    %false_total = add.i64 %f_sum7, %false_char_wide

    # Combine results
    %result = add.i64 %true_total, %false_total
    ret.i64 %result
}

# Test i8 conversions
fn @test_i8_value_conversions() -> i64 {
  entry:
    %val_i8 = add.i8 65, 0  # 'A'

    # Convert i8 to all other types
    %to_i8 = add.i8 %val_i8, 0
    %to_u8 = bitcast.i8.u8 %val_i8
    %to_i16_bits2 = bitcast.i8.u8 %val_i8
    %to_i16 = extend.u8.i16 %to_i16_bits2
    %to_u16_bits2 = bitcast.i8.u8 %val_i8
    %to_u16 = extend.u8.u16 %to_u16_bits2
    %to_i32_bits3 = bitcast.i8.u8 %val_i8
    %to_i32 = extend.u8.i32 %to_i32_bits3
    %to_u32_bits3 = bitcast.i8.u8 %val_i8
    %to_u32 = extend.u8.u32 %to_u32_bits3
    %to_i64_bits4 = bitcast.i8.u8 %val_i8
    %to_i64 = extend.u8.i64 %to_i64_bits4
    %to_u64_bits4 = bitcast.i8.u8 %val_i8
    %to_u64 = extend.u8.u64 %to_u64_bits4
    %to_bool = ne.i8 %val_i8, 0

    # Convert back to i64 for verification
    %i8_i64_bits8 = bitcast.i8.u8 %to_i8
    %i8_i64 = extend.u8.i64 %i8_i64_bits8
    %u8_i64 = extend.u8.i64 %to_u8
    %i16_i64_bits8 = bitcast.i16.u16 %to_i16
    %i16_i64 = extend.u16.i64 %i16_i64_bits8
    %u16_i64 = extend.u16.i64 %to_u16
    %i32_i64_bits8 = bitcast.i32.u32 %to_i32
    %i32_i64 = extend.u32.i64 %i32_i64_bits8
    %u32_i64 = extend.u32.i64 %to_u32
    %bool_i64 = extend.bool.i64 %to_bool

    # Sum all converted values
    %sum1 = add.i64 %i8_i64, %u8_i64
    %sum2 = add.i64 %sum1, %i16_i64
    %sum3 = add.i64 %sum2, %u16_i64
    %sum4 = add.i64 %sum3, %i32_i64
    %sum5 = add.i64 %sum4, %u32_i64
    %sum6 = add.i64 %sum5, %to_i64
    %sum7 = add.i64 %sum6, %to_u64
    %result = add.i64 %sum7, %bool_i64

    ret.i64 %result
}

# Test floating point conversions (limited due to IR constraints)
# COMMENTED OUT: Parser issues with float literals
# fn @test_float_conversions() -> i64 {
