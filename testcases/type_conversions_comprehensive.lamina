# ===== MAIN FUNCTION =====

fn @main() -> i64 {
  entry:
    # Test all type conversions
    %i8_result = call @test_i8_conversions()
    %u8_result = call @test_u8_conversions()
    %i16_result = call @test_i16_conversions()
    %u16_result = call @test_u16_conversions()
    %i32_result = call @test_i32_conversions()
    %u32_result = call @test_u32_conversions()
    %i64_result = call @test_i64_conversions()
    %u64_result = call @test_u64_conversions()
    %bool_result = call @test_bool_conversions()
    %char_result = call @test_i8_value_conversions()
    # %float_result = call @test_float_conversions()  # Commented out due to parser issues

    # Print results
    call @print_i64(%i8_result)
    call @print_i64(%u8_result)
    call @print_i64(%i16_result)
    call @print_i64(%u16_result)
    call @print_i64(%i32_result)
    call @print_i64(%u32_result)
    call @print_i64(%i64_result)
    call @print_i64(%u64_result)
    call @print_i64(%bool_result)
    call @print_i64(%char_result)
    # print %float_result  # Commented out

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
