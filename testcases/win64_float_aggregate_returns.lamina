type !F1 = struct { a: f32 }
type !F2 = struct { a: f32, b: f32 }
type !DF = struct { a: f64 }
type !F3 = struct { a: f32, b: f32, c: f32 }
type !D2 = struct { a: f64, b: f64 }

fn @make1(f32 %x) -> !F1 {
entry:
    %p = stackalloc.!F1
    %pa = getfieldptr.!F1 %p, 0
    store.f32 %pa, %x
    ret.!F1 %p
}

fn @make2(f32 %x) -> !F2 {
entry:
    %p = stackalloc.!F2
    %pa = getfieldptr.!F2 %p, 0
    %pb = getfieldptr.!F2 %p, 1
    store.f32 %pa, %x
    %y = mul.f32 %x, 3.0
    store.f32 %pb, %y
    ret.!F2 %p
}

fn @maked1(f64 %x) -> !DF {
entry:
    %p = stackalloc.!DF
    %pa = getfieldptr.!DF %p, 0
    store.f64 %pa, %x
    ret.!DF %p
}

fn @make3(f32 %x) -> !F3 {
entry:
    %p = stackalloc.!F3
    %pa = getfieldptr.!F3 %p, 0
    %pb = getfieldptr.!F3 %p, 1
    %pc = getfieldptr.!F3 %p, 2
    store.f32 %pa, %x
    %y = add.f32 %x, 1.0
    store.f32 %pb, %y
    %z = add.f32 %y, 1.0
    store.f32 %pc, %z
    ret.!F3 %p
}

fn @maked2(f64 %x) -> !D2 {
entry:
    %p = stackalloc.!D2
    %pa = getfieldptr.!D2 %p, 0
    %pb = getfieldptr.!D2 %p, 1
    store.f64 %pa, %x
    %y = mul.f64 %x, 2.0
    store.f64 %pb, %y
    ret.!D2 %p
}

fn @print_i64(i64 %n) -> void {
entry:
    %neg = lt.i64 %n, 0
    %m = sub.i64 0, %n
    %s = select.i64 %neg, %m, %n
    %u = bitcast.i64.u64 %s
    br %neg, minus, digits
minus:
    %c = writebyte 45
    jmp digits
digits:
    call @put_u64(%u)
    %nl = writebyte 10
    ret.void
}

fn @put_u64(u64 %n) -> void {
entry:
    %q = div.u64 %n, 10
    %r = rem.u64 %n, 10
    %d = add.u64 %r, 48
    %z = eq.u64 %q, 0
    br %z, last, more
more:
    call @put_u64(%q)
    jmp last
last:
    %w = writebyte %d
    ret.void
}

fn @main() -> i64 {
entry:
    %a = call @make1(4.0)
    %aa = getfieldptr.!F1 %a, 0
    %av = load.f32 %aa
    %ai = fptoint.f32.i64 %av
    call @print_i64(%ai)

    %b = call @make2(2.0)
    %bb = getfieldptr.!F2 %b, 1
    %bv = load.f32 %bb
    %bi = fptoint.f32.i64 %bv
    call @print_i64(%bi)

    %c = call @maked1(6.5)
    %cc = getfieldptr.!DF %c, 0
    %cv = load.f64 %cc
    %ci = fptoint.f64.i64 %cv
    call @print_i64(%ci)

    %d = call @make3(1.0)
    %dc = getfieldptr.!F3 %d, 2
    %dv = load.f32 %dc
    %di = fptoint.f32.i64 %dv
    call @print_i64(%di)

    %e = call @maked2(3.0)
    %ee = getfieldptr.!D2 %e, 1
    %ev = load.f64 %ee
    %ei = fptoint.f64.i64 %ev
    call @print_i64(%ei)
    ret.i64 0
}
