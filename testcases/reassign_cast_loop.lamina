# A cast result reassigned inside a loop and read at the top of the next iteration. The
# carried value must come from the latest definition: the sum is 100 + 1 + 2 = 103.
fn @main() -> i64 {
  entry:
    %z = add.i64 0, 100
    %x = bitcast.i64.f64 %z
    %acc = add.i64 0, 0
    %i = add.i64 0, 0
    jmp loop
  loop:
    %v = bitcast.f64.i64 %x
    %acc = add.i64 %acc, %v
    %i2 = add.i64 %i, 1
    %x = bitcast.i64.f64 %i2
    %i = add.i64 %i2, 0
    %c = lt.i64 %i, 3
    br %c, loop, done
  done:
    call @print_i64(%acc)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
