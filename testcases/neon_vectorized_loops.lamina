fn @main() -> i64 {
entry:
  %r0 = call @i8_add()
  call @print_i64(%r0)
  %r1 = call @i8_sub()
  call @print_i64(%r1)
  %r2 = call @i8_and()
  call @print_i64(%r2)
  %r3 = call @i8_or()
  call @print_i64(%r3)
  %r4 = call @i8_xor()
  call @print_i64(%r4)
  %r5 = call @i8_mul()
  call @print_i64(%r5)
  %r6 = call @i16_add()
  call @print_i64(%r6)
  %r7 = call @i16_sub()
  call @print_i64(%r7)
