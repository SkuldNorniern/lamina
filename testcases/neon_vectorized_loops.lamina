# element-wise self-loops the vectorizer widens at O3, every lane width and operation
fn @i8_add() -> i64 {
entry:
  %a = stackalloc.[64 x i8]
  %j = add.i64 0, 0
  jmp fill
fill:
  %more = lt.i64 %j, 64
  br %more, fbody, go
fbody:
  %p = getelem.i8 %a, %j
  %v = mul.i64 %j, 37
  %w = trunc.i64.i8 %v
  store.i8 %p, %w
  %j = add.i64 %j, 1
  jmp fill
go:
  %i = add.i64 0, 0
  jmp head
head:
  %again = lt.i64 %i, 64
  br %again, body, sum
body:
  %q = getelem.i8 %a, %i
  %x = load.i8 %q
  %y = add.i8 %x, 91
  store.i8 %q, %y
  %i = add.i64 %i, 1
  jmp head
sum:
  %k = add.i64 0, 0
  %t = add.i64 0, 0
  jmp shead
shead:
  %m = lt.i64 %k, 64
  br %m, sbody, done
sbody:
  %r = getelem.i8 %a, %k
  %z = load.i8 %r
  %e = extend.i8.i64 %z
  %t = add.i64 %t, %e
  %k = add.i64 %k, 1
  jmp shead
done:
  ret.i64 %t
}

