  %r11 = call @i16_mul()
  call @print_i64(%r11)
  %r12 = call @i32_add()
  call @print_i64(%r12)
  %r13 = call @i32_sub()
  call @print_i64(%r13)
  %r14 = call @i32_and()
  call @print_i64(%r14)
  %r15 = call @i32_or()
  call @print_i64(%r15)
  %r16 = call @i32_xor()
  call @print_i64(%r16)
  %r17 = call @i32_mul()
  call @print_i64(%r17)
  %r18 = call @i64_add()
  call @print_i64(%r18)
  %r19 = call @i64_sub()
  call @print_i64(%r19)
  %r20 = call @i64_and()
  call @print_i64(%r20)
  %r21 = call @i64_or()
  call @print_i64(%r21)
  %r22 = call @i64_xor()
  call @print_i64(%r22)
  %r23 = call @i64_mul()
  call @print_i64(%r23)
  %r24 = call @f32_add()
  call @print_i64(%r24)
  %r25 = call @f32_sub()
  call @print_i64(%r25)
  %r26 = call @f32_mul()
  call @print_i64(%r26)
  %r27 = call @f64_add()
  call @print_i64(%r27)
  %r28 = call @f64_sub()
  call @print_i64(%r28)
  %r29 = call @f64_mul()
  call @print_i64(%r29)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
