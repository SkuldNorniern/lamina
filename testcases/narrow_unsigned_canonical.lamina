# A narrow value is held sign-extended to 64 bits inside a function whatever its
# declared signedness, so an unsigned parameter and an unsigned call result must be
# normalised the same way an arithmetic result is.
fn @xor_eq_u8(u8 %p) -> i64 {
  entry:
    %x = xor.u8 0, %p
    %c = eq.u8 %p, %x
    %w = zext.bool.i64 %c
    ret.i64 %w
}

fn @add_eq_u16(u16 %p) -> i64 {
  entry:
    %x = add.u16 %p, 0
    %c = eq.u16 %p, %x
    %w = zext.bool.i64 %c
    ret.i64 %w
}

fn @or_eq_u32(u32 %p) -> i64 {
  entry:
    %x = or.u32 %p, 0
    %c = eq.u32 %p, %x
    %w = zext.bool.i64 %c
    ret.i64 %w
}

fn @mk_u8() -> u8 {
  entry:
    %v = trunc.i64.u8 255
    ret.u8 %v
}

fn @main() -> i64 {
  entry:
    %a = call @xor_eq_u8(255)
    print %a
    %b = call @xor_eq_u8(5)
    print %b
    %c = call @add_eq_u16(65535)
    print %c
    %d = call @or_eq_u32(4294967295)
    print %d
    %r = call @mk_u8()
    %s = xor.u8 %r, 0
    %e = eq.u8 %r, %s
    %ew = zext.bool.i64 %e
    print %ew
    %rw = zext.u8.i64 %r
    print %rw
    %big = gt.u8 %r, 1
    %bigw = zext.bool.i64 %big
    print %bigw
    %q = div.u8 %r, 5
    %qw = zext.u8.i64 %q
    print %qw
    ret.i64 0
}
