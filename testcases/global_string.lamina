global $greeting: [6 x i8] = "hello"
global $blank: [4 x i8]

fn @main() -> i64 {
entry:
 %p = getelem.i8 $greeting, 0
 write %p, 5, n
 %nl = writebyte 10
 print %n
 %c = load.i8 %p
 %cw = sext.i8.i64 %c
 print %cw
 %p4 = getelem.i8 $greeting, 4
 %c4 = load.i8 %p4
 %c4w = sext.i8.i64 %c4
 print %c4w
 %b = getelem.i8 $blank, 0
 %z = load.i8 %b
 %zw = sext.i8.i64 %z
 print %zw
 store.i8 %b, 90
 %z2 = load.i8 %b
 %z2w = sext.i8.i64 %z2
 print %z2w
 ret.i64 0
}
