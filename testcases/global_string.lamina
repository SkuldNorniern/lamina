global $greeting: [6 x i8] = "hello"
global $blank: [4 x i8]

fn @main() -> i64 {
entry:
 %p = getelem.i8 $greeting, 0
 write %p, 5, n
 %nl = writebyte 10
 call @print_i64(%n)
 %c = load.i8 %p
 %cw = extend.i8.i64 %c
 call @print_i64(%cw)
 %p4 = getelem.i8 $greeting, 4
 %c4 = load.i8 %p4
 %c4w = extend.i8.i64 %c4
 call @print_i64(%c4w)
 %b = getelem.i8 $blank, 0
 %z = load.i8 %b
 %zw = extend.i8.i64 %z
 call @print_i64(%zw)
 store.i8 %b, 90
 %z2 = load.i8 %b
 %z2w = extend.i8.i64 %z2
 call @print_i64(%z2w)
 ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
