# Test stdin read operations - matches test runner expectations
fn @main() -> i64 {
    entry:
        # Read first byte (should be 'A' = 65)
        %byte1 = readbyte
        call @print_i64(%byte1)

        # Read second byte (should be EOF/newline = 10)
        %byte2 = readbyte
        call @print_i64(%byte2)

        # Read third byte (should be 'B' = 66)
        %byte3 = readbyte
        call @print_i64(%byte3)

        # Return the first byte value (should be 65)
        ret.i64 %byte1
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
