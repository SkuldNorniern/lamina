# Test buffer-based I/O operations
fn @main() -> i32 {
  entry:
    # Test writing a buffer (simulated with individual bytes)
    %b1 = writebyte 66   # 'B'
    %b2 = writebyte 117  # 'u'
    %b3 = writebyte 102  # 'f'
    %b4 = writebyte 102  # 'f'
    %b5 = writebyte 101  # 'e'
    %b6 = writebyte 114  # 'r'
    %b7 = writebyte 10   # '\n'

    # Test reading multiple bytes (if available)
    %c1 = readbyte
    %c2 = readbyte
    %c3 = readbyte

    # Print the read bytes
    call @print_i64(%c1)
    call @print_i64(%c2)
    call @print_i64(%c3)

    ret.i32 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
