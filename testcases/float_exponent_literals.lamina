@extern
fn @printf(ptr %fmt, ...) -> i32

@extern
fn @fflush(ptr %f) -> i32

global $fmt_g: [4 x i8] = "%g\n"

global $tiny: f64 = 1.5e-3

fn @main() -> i64 {
entry:
  %a = add.f64 1.0e40, 0.0
  %b = fpcast.f64.f32 %a
  %pv0 = fpcast.f32.f64 %b
  call @print_f64(%pv0)
  %c = add.f64 2.5E3, 0.5
  call @print_f64(%c)
  %d = add.f32 1.25e2, 0.0
  %pv2 = fpcast.f32.f64 %d
  call @print_f64(%pv2)
  %e = load.f64 $tiny
  call @print_f64(%e)
  %f = sub.f64 0.0, 3.0e-2
  call @print_f64(%f)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}

fn @print_f64(f64 %x) -> i64 {
entry:
  %p = getelem.i8 $fmt_g, 0
  %r = call @printf(%p, %x)
  %n = inttoptr.i64 0
  %z = call @fflush(%n)
  ret.i64 0
}
