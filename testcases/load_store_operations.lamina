# Test memory aliasing (same pointer used differently)
fn @test_memory_aliasing() -> i64 {
  entry:
    %ptr = stackalloc.i64

    # Store initial value
    store.i64 %ptr, 50

    # Load through different "paths" (conceptually)
    %val1 = load.i64 %ptr
    %val2 = load.i64 %ptr  # Same memory location

    # Modify through one reference
    %new_val = add.i64 %val1, 25
    store.i64 %ptr, %new_val

    # Load through other reference
    %val3 = load.i64 %ptr

    # All should be the same final value
    %sum = add.i64 %val1, %val2
    %total = add.i64 %sum, %val3

    ret.i64 %total  # Should be 150 (50 + 50 + 75)
}

# Test load/store in loop-like patterns
fn @test_sequential_access() -> i64 {
  entry:
    %ptr = stackalloc.i64

    # Initialize
    store.i64 %ptr, 0

    # Simulate loop: add 1 ten times
    %current = load.i64 %ptr
    %step1 = add.i64 %current, 1
    store.i64 %ptr, %step1

    %current = load.i64 %ptr
    %step2 = add.i64 %current, 1
    store.i64 %ptr, %step2

    %current = load.i64 %ptr
    %step3 = add.i64 %current, 1
    store.i64 %ptr, %step3

    %current = load.i64 %ptr
    %step4 = add.i64 %current, 1
    store.i64 %ptr, %step4

    %current = load.i64 %ptr
    %step5 = add.i64 %current, 1
    store.i64 %ptr, %step5

    %current = load.i64 %ptr
    %step6 = add.i64 %current, 1
    store.i64 %ptr, %step6

    %current = load.i64 %ptr
    %step7 = add.i64 %current, 1
    store.i64 %ptr, %step7

    %current = load.i64 %ptr
    %step8 = add.i64 %current, 1
    store.i64 %ptr, %step8

    %current = load.i64 %ptr
    %step9 = add.i64 %current, 1
    store.i64 %ptr, %step9

    %current = load.i64 %ptr
    %step10 = add.i64 %current, 1
    store.i64 %ptr, %step10

    # Load final result
    %final = load.i64 %ptr

    ret.i64 %final  # Should be 10
}

fn @main() -> i64 {
  entry:
    %basic_result = call @test_basic_load_store()      # Should return 1 (true)

    call @print_i64(%basic_result)

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
