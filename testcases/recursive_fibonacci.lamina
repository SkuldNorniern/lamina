# Test recursive fibonacci with different inputs
fn @fibonacci(i64 %n) -> i64 {
  entry:
    %is_zero = eq.i64 %n, 0
    br %is_zero, return_zero, check_one

  return_zero:
    ret.i64 0

  check_one:
    %is_one = eq.i64 %n, 1
    br %is_one, return_one, recursive_case

  return_one:
    ret.i64 1

  recursive_case:
    %n_minus_1 = sub.i64 %n, 1
    %n_minus_2 = sub.i64 %n, 2
    %fib_n_minus_1 = call @fibonacci(%n_minus_1)
    %fib_n_minus_2 = call @fibonacci(%n_minus_2)
    %result = add.i64 %fib_n_minus_1, %fib_n_minus_2
    ret.i64 %result
}

fn @main() -> i64 {
  entry:
    %result1 = call @fibonacci(0)  # Should be 0
    %result2 = call @fibonacci(1)  # Should be 1
    %result3 = call @fibonacci(2)  # Should be 1
    %result4 = call @fibonacci(3)  # Should be 2
    %result5 = call @fibonacci(4)  # Should be 3
    %result6 = call @fibonacci(5)  # Should be 5
    
    call @print_i64(%result1)
    call @print_i64(%result2)
    call @print_i64(%result3)
    call @print_i64(%result4)
    call @print_i64(%result5)
    call @print_i64(%result6)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
