type !Quad = struct { a: i64, b: i64, c: i64, d: i64 }
type !Pair = struct { x: i64, y: i64 }

fn @big(i64 %p0, i64 %p1, f64 %f0, !Pair %pr, i64 %p2, i64 %p3, f64 %f1, !Quad %q, i64 %p4, i64 %p5, i64 %p6) -> !Quad {
entry:
  %out = stackalloc.!Quad
  %px = getfieldptr %pr, 0
  %x = load.i64 %px
  %py = getfieldptr %pr, 1
  %y = load.i64 %py
  %qa = getfieldptr %q, 0
  %a = load.i64 %qa
  %qd = getfieldptr %q, 3
  %d = load.i64 %qd
  %s0 = add.i64 %p0, %p1
  %s1 = add.i64 %s0, %p2
  %s2 = add.i64 %s1, %p3
  %s3 = add.i64 %s2, %p4
  %s4 = add.i64 %s3, %p5
  %s5 = add.i64 %s4, %p6
  %s6 = add.i64 %s5, %x
  %s7 = add.i64 %s6, %y
  %s8 = add.i64 %s7, %a
  %s9 = add.i64 %s8, %d
  %fs = add.f64 %f0, %f1
  %fi = fptoint.f64.i64 %fs
  %s10 = add.i64 %s9, %fi
  %o0 = getfieldptr %out, 0
  store.i64 %o0, %s10
  %o1 = getfieldptr %out, 1
  store.i64 %o1, %x
  %o2 = getfieldptr %out, 2
  store.i64 %o2, %a
  %o3 = getfieldptr %out, 3
  store.i64 %o3, %fi
  ret.ptr %out
}

fn @main() -> i64 {
entry:
  %pr = stackalloc.!Pair
  %px = getfieldptr %pr, 0
  store.i64 %px, 100
  %py = getfieldptr %pr, 1
  store.i64 %py, 200
  %q = stackalloc.!Quad
  %qa = getfieldptr %q, 0
  store.i64 %qa, 1
  %qb = getfieldptr %q, 1
  store.i64 %qb, 2
  %qc = getfieldptr %q, 2
  store.i64 %qc, 3
  %qd = getfieldptr %q, 3
  store.i64 %qd, 4
  %r = call @big(1, 2, 1.5, %pr, 3, 4, 2.5, %q, 5, 6, 7)
  %r0 = getfieldptr %r, 0
  %v0 = load.i64 %r0
  call @print_i64(%v0)
  %r1 = getfieldptr %r, 1
  %v1 = load.i64 %r1
  call @print_i64(%v1)
  %r3 = getfieldptr %r, 3
  %v3 = load.i64 %r3
  call @print_i64(%v3)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
