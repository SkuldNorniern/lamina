# The result is never read, but the template still runs
fn @main() -> i64 {
entry:
  %p = stackalloc.i32
  %v = add.i32 41, 0
  store.i32 %p, %v
  %u = asm.i32 "addl $$1, ($0)\nmovl $$0, $1", in(reg) %p, out(reg), clobber(memory, flags)
  %m = load.i32 %p
  %ok = eq.i32 %m, 42
  br %ok, good, bad
good:
  %o = writebyte 79
  %k = writebyte 75
  %nl = writebyte 10
  ret.i64 0
bad:
  %f = writebyte 70
  %nl2 = writebyte 10
  ret.i64 1
}
