fn @main() -> i64 {
entry:
  %tape = stackalloc.[100 x i32]
  %data_ptr = stackalloc.i32
  store.i32 %data_ptr, 0
  %op_counter = stackalloc.i32
  store.i32 %op_counter, 0

  %idx0 = load.i32 %data_ptr
  %idx0_64 = zext.i32.i64 %idx0
  %cell_ptr0 = getelem.i32 %tape, %idx0_64
  store.i32 %cell_ptr0, 0

  %value0 = load.i32 %cell_ptr0
  %value1 = add.i32 %value0, 1
  store.i32 %cell_ptr0, %value1
  %count0 = load.i32 %op_counter
  %count1 = add.i32 %count0, 1
  store.i32 %op_counter, %count1

  %idx1 = load.i32 %data_ptr
  %idx1_64 = zext.i32.i64 %idx1
  %cell_ptr1 = getelem.i32 %tape, %idx1_64
  %value2 = load.i32 %cell_ptr1
  %value3 = add.i32 %value2, 1
  store.i32 %cell_ptr1, %value3
  %count2 = load.i32 %op_counter
  %count3 = add.i32 %count2, 1
  store.i32 %op_counter, %count3

  %idx2 = load.i32 %data_ptr
  %idx2_64 = zext.i32.i64 %idx2
  %cell_ptr2 = getelem.i32 %tape, %idx2_64
  %current_cell = load.i32 %cell_ptr2
  %pv0 = sext.i32.i64 %current_cell
  call @print_i64(%pv0)

  %count4 = load.i32 %op_counter
  %count5 = add.i32 %count4, 1
  store.i32 %op_counter, %count5
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
