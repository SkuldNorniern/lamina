fn @case0() -> i64 {
entry:
  %v = add.i128 0, 0
  %f = inttofp.i128.f64 %v
  %w = fptoint.f64.i128 %f
  %lo = trunc.i128.i64 %w
  call @print_i64(%lo)
  %hs = shr.i128 %w, 64
  %hi = trunc.i128.i64 %hs
  call @print_i64(%hi)
  ret.i64 0
}

