# Division and remainder with runtime divisors: operands either side of the 32-bit
# boundary, all sign combinations, and mixed narrow/wide operands. Expected values are Python integers.
# A zero divisor and i64::MIN / -1 trap and are not part of this test.

fn @sdiv(i64 %a, i64 %b) -> i64 {
  entry:
    %q = div.i64 %a, %b
    ret.i64 %q
}

fn @srem(i64 %a, i64 %b) -> i64 {
  entry:
    %r = rem.i64 %a, %b
    ret.i64 %r
}

fn @udiv(u64 %a, u64 %b) -> u64 {
  entry:
    %q = div.u64 %a, %b
    ret.u64 %q
}

fn @urem(u64 %a, u64 %b) -> u64 {
  entry:
    %r = rem.u64 %a, %b
    ret.u64 %r
}

