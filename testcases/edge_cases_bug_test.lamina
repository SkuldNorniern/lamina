# Test case to expose edge cases and potential overflow bugs
# This test covers boundary conditions, overflows, and edge cases
# that might expose bugs in the code generation

fn @test_i8_overflow() -> i64 {
  entry:
    # Test i8 boundary values
    %max_i8 = add.i8 127, 0      # Maximum i8 value
    %min_i8 = sub.i8 -127, 1      # Minimum i8 value (two's complement)

    # Test operations that might overflow
    %overflow_add = add.i8 %max_i8, 1    # Should wrap around to -128
    %overflow_sub = sub.i8 %min_i8, 1    # Should wrap around to 127

    # Convert to i64 to see the actual values
    %max_i64_bits = bitcast.i8.u8 %max_i8
    %max_i64 = extend.u8.i64 %max_i64_bits
    %min_i64_bits = bitcast.i8.u8 %min_i8
    %min_i64 = extend.u8.i64 %min_i64_bits
    %over_add_i64_bits = bitcast.i8.u8 %overflow_add
    %over_add_i64 = extend.u8.i64 %over_add_i64_bits
    %over_sub_i64_bits = bitcast.i8.u8 %overflow_sub
    %over_sub_i64 = extend.u8.i64 %over_sub_i64_bits

    # Return a combination: max + min*1000 + over_add*1000000 + over_sub*1000000000
    %min_scaled = mul.i64 %min_i64, 1000
    %over_add_scaled = mul.i64 %over_add_i64, 1000000
    %over_sub_scaled = mul.i64 %over_sub_i64, 1000000000

    %sum1 = add.i64 %max_i64, %min_scaled
    %sum2 = add.i64 %sum1, %over_add_scaled
    %result = add.i64 %sum2, %over_sub_scaled

    ret.i64 %result
}

fn @test_i16_overflow() -> i64 {
  entry:
    # Test i16 boundary values
    %max_i16 = add.i16 32767, 0      # Maximum i16 value
    %min_i16 = sub.i16 -32767, 1      # Minimum i16 value

    # Test operations that might overflow
    %overflow_add = add.i16 %max_i16, 1    # Should wrap around
    %overflow_sub = sub.i16 %min_i16, 1    # Should wrap around

    # Convert to i64
    %max_i64_bits2 = bitcast.i16.u16 %max_i16
    %max_i64 = extend.u16.i64 %max_i64_bits2
    %min_i64_bits2 = bitcast.i16.u16 %min_i16
    %min_i64 = extend.u16.i64 %min_i64_bits2
    %over_add_i64_bits2 = bitcast.i16.u16 %overflow_add
    %over_add_i64 = extend.u16.i64 %over_add_i64_bits2
    %over_sub_i64_bits2 = bitcast.i16.u16 %overflow_sub
    %over_sub_i64 = extend.u16.i64 %over_sub_i64_bits2

    # Return combination
    %min_scaled = mul.i64 %min_i64, 1000000
    %over_add_scaled = mul.i64 %over_add_i64, 1000000000000
    %over_sub_scaled = mul.i64 %over_sub_i64, 1000000000000000

    %sum1 = add.i64 %max_i64, %min_scaled
    %sum2 = add.i64 %sum1, %over_add_scaled
    %result = add.i64 %sum2, %over_sub_scaled

    ret.i64 %result
}

fn @test_zero_division() -> i64 {
  entry:
    # Test division by non-zero (avoiding division by zero)
    %a = add.i32 100, 0
    %non_zero = add.i32 5, 0

    # This should work fine
    %result = div.i32 %a, %non_zero

    %final_bits = bitcast.i32.u32 %result
    %final = extend.u32.i64 %final_bits
    ret.i64 %final
}

fn @test_negative_division() -> i64 {
  entry:
    # Test division with negative numbers
    %a = sub.i32 0, 20     # -20
    %b = add.i32 3, 0      # 3
    %c = sub.i32 0, 3      # -3

    %result1 = div.i32 %a, %b  # -20 / 3 = -6 (in integer division)
    %result2 = div.i32 %a, %c  # -20 / -3 = 6

    %r1_i64_bits = bitcast.i32.u32 %result1
    %r1_i64 = extend.u32.i64 %r1_i64_bits
    %r2_i64_bits = bitcast.i32.u32 %result2
    %r2_i64 = extend.u32.i64 %r2_i64_bits

    %combined = add.i64 %r1_i64, %r2_i64
    ret.i64 %combined
}

fn @test_large_numbers() -> i64 {
  entry:
    # Test operations with large numbers (avoiding problematic constants)
    %big1 = add.i64 1000000000, 0  # Large but manageable number
    %big2 = add.i64 1000000, 0     # Smaller divisor

    %result = div.i64 %big1, %big2
    ret.i64 %result
}

fn @main() -> i64 {
  entry:
    %i8_overflow = call @test_i8_overflow()
    %i16_overflow = call @test_i16_overflow()
    %zero_div = call @test_zero_division()
    %neg_div = call @test_negative_division()
    %large_nums = call @test_large_numbers()

    call @print_i64(%i8_overflow)    # Complex result from overflow tests
    call @print_i64(%i16_overflow)   # Complex result from overflow tests
    call @print_i64(%zero_div)       # Result of division by zero
    call @print_i64(%neg_div)        # Should be 0 (-6 + 6)
    call @print_i64(%large_nums)     # Result of large number division

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
