fn @main() -> i64 {
entry:
  %acc = stackalloc.i64
  store.i64 %acc, 0
  %i = stackalloc.i64
  store.i64 %i, 1
  jmp loop
loop:
  %iv = load.i64 %i
  %more = le.i64 %iv, 40
  br %more, body, done
body:
  %m = mul.i64 %iv, 2654435761
  %p = popcount.i64 %m
  %lz = ctlz.i64 %m
  %tz = cttz.i64 %m
  %bs = bswap.i64 %m
  %r1 = rotl.i64 %m, %iv
  %r2 = rotr.i64 %m, %iv
  %t1 = add.i64 %p, %lz
  %t2 = add.i64 %t1, %tz
  %t3 = xor.i64 %bs, %r1
  %t4 = xor.i64 %t3, %r2
  %a0 = load.i64 %acc
  %a1 = add.i64 %a0, %t2
  %a2 = xor.i64 %a1, %t4
  store.i64 %acc, %a2
  %inext = add.i64 %iv, 1
  store.i64 %i, %inext
  jmp loop
done:
  %res = load.i64 %acc
  call @print_i64(%res)
  %b = trunc.i64.i8 %res
  %pb = popcount.i8 %b
  %rb = rotl.i8 %b, 3
  %sb = bswap.i8 %rb
  %x1 = zext.i8.i64 %pb
  call @print_i64(%x1)
  %x2 = sext.i8.i64 %sb
  call @print_i64(%x2)
  %w = trunc.i64.u16 %res
  %bw = bswap.u16 %w
  %x3 = zext.u16.i64 %bw
  call @print_i64(%x3)
  %u = trunc.i64.u32 %res
  %cu = ctlz.u32 %u
  %tu = cttz.u32 %u
  %x4 = zext.u32.i64 %cu
  call @print_i64(%x4)
  %x5 = zext.u32.i64 %tu
  call @print_i64(%x5)
  %ru = rotr.u32 %u, 7
  %x6 = zext.u32.i64 %ru
  call @print_i64(%x6)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
