# i128 in stack slots, through pointer parameters, in a phi loop, and in select.
fn @store_through(ptr %p, i128 %v) -> void {
entry:
  store.i128 %p, %v
  ret.void
}

fn @loop_sum() -> i128 {
entry:
  jmp head
head:
  %acc = phi.i128 [0, entry], [%next, body]
  %i = phi.i64 [1, entry], [%inext, body]
  %more = le.i64 %i, 40
  br %more, body, done
body:
  %t = mul.i128 %acc, 3
  %ii_bits = bitcast.i64.u64 %i
  %ii = extend.u64.i128 %ii_bits
  %next = add.i128 %t, %ii
  %inext = add.i64 %i, 1
  jmp head
done:
  ret.i128 %acc
}

fn @pick(i128 %a, i128 %b) -> i128 {
entry:
  %c = lt.i128 %a, %b
  %r = select.i128 %c, %b, %a
  ret.i128 %r
}

fn @main() -> i64 {
entry:
  %slot = stackalloc.i128
  %seed = add.i128 -170141183460469231731687303715884105000, 0
  store.i128 %slot, %seed
  %back = load.i128 %slot
  %loa = trunc.i128.i64 %back
  call @print_i64(%loa)
  %hsa = shr.i128 %back, 64
  %hia = trunc.i128.i64 %hsa
  call @print_i64(%hia)
  %other = stackalloc.i128
  call @store_through(%other, %seed)
  %via = load.i128 %other
  %lob = trunc.i128.i64 %via
  call @print_i64(%lob)
  %hsb = shr.i128 %via, 64
  %hib = trunc.i128.i64 %hsb
  call @print_i64(%hib)
  %sum = call @loop_sum()
  %loc = trunc.i128.i64 %sum
  call @print_i64(%loc)
  %hsc = shr.i128 %sum, 64
  %hic = trunc.i128.i64 %hsc
  call @print_i64(%hic)
  %pa = add.i128 1267650600228229401496703205385, 0
  %pb = add.i128 -1237940039285380274899124223, 0
  %mx = call @pick(%pa, %pb)
  %lod = trunc.i128.i64 %mx
  call @print_i64(%lod)
  %hsd = shr.i128 %mx, 64
  %hid = trunc.i128.i64 %hsd
  call @print_i64(%hid)
  %mn = call @pick(%pb, %pa)
  %loe = trunc.i128.i64 %mn
  call @print_i64(%loe)
  %hse = shr.i128 %mn, 64
  %hie = trunc.i128.i64 %hse
  call @print_i64(%hie)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
