# Comprehensive I/O test combining all operations
fn @main() -> i64 {
  entry:
    # Test 1: Basic character output
    %h = writebyte 72   # 'H'
    %i = writebyte 105  # 'i'
    %ex = writebyte 33  # '!'
    %nl = writebyte 10  # '\n'

    # Test 2: Buffer operations
    %buffer = stackalloc.i64
    store.i64 %buffer, 12345         # Store known value in buffer
    %buffer_val = load.i64 %buffer    # Load the buffer value for printing
    call @print_i64(%buffer_val)             # Should print 12345

    # Test 3: More output
    %done = writebyte 68   # 'D'
    %one = writebyte 79    # 'O'
    %ne = writebyte 78     # 'N'
    %e = writebyte 69      # 'E'
    %nl2 = writebyte 10    # '\n'

    # Test 4: Arithmetic with buffer value
    %sum = add.i64 %buffer_val, 100
    call @print_i64(%sum)  # Should print 12445

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
