fn @sink(f64 %x, i64 %n) -> i64 {
entry:
  %i = fptoint.f64.i64 %x
  %r = add.i64 %i, %n
  ret.i64 %r
}

fn @forward(f64 %x, i64 %n) -> i64 {
entry:
  %r = call @sink(%x, %n)
  ret.i64 %r
}

fn @main() -> i64 {
entry:
  %a = call @forward(2.5, 40)
  call @print_i64(%a)
  %b = call @forward(100.0, 1)
  call @print_i64(%b)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
