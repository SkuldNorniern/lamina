# values held in callee-saved registers across a call that leaves through a tail call
fn @mix(i64 %a, i64 %b, i64 %c) -> i64 {
entry:
  %x = mul.i64 %a, 3
  %y = add.i64 %b, %x
  %z = xor.i64 %c, %y
  ret.i64 %z
}

fn @relay(i64 %s) -> i64 {
entry:
  %a1 = mul.i64 %s, 3
  %a2 = mul.i64 %s, 5
  %a3 = mul.i64 %s, 7
  %a4 = mul.i64 %s, 11
  %a5 = mul.i64 %s, 13
  %a6 = mul.i64 %s, 17
  %a7 = mul.i64 %s, 19
  %a8 = mul.i64 %s, 23
  %noted = call @mix(%a1, %a2, %a3)
  %b1 = xor.i64 %a1, %a8
  %b2 = xor.i64 %a2, %a7
  %b3 = xor.i64 %a3, %a6
  %b4 = xor.i64 %a4, %a5
  %c1 = add.i64 %b1, %b2
  %c2 = add.i64 %b3, %b4
  %c3 = add.i64 %noted, %c2
  %r = call @mix(%c1, %c2, %c3)
  ret.i64 %r
}

fn @main() -> i64 {
entry:
  %v1 = stackalloc.i64
  store.i64 %v1, 9
  %s = load.i64 %v1
  %k1 = mul.i64 %s, 29
  %k2 = mul.i64 %s, 31
  %k3 = mul.i64 %s, 37
  %k4 = mul.i64 %s, 41
  %k5 = mul.i64 %s, 43
  %k6 = mul.i64 %s, 47
  %k7 = mul.i64 %s, 53
  %k8 = mul.i64 %s, 59
  %r1 = call @relay(%s)
  %r2 = call @relay(%k1)
  call @print_i64(%r1)
  call @print_i64(%r2)
  %t1 = add.i64 %k1, %k2
  %t2 = add.i64 %t1, %k3
  %t3 = add.i64 %t2, %k4
  %t4 = add.i64 %t3, %k5
  %t5 = add.i64 %t4, %k6
  %t6 = add.i64 %t5, %k7
  %t7 = add.i64 %t6, %k8
  call @print_i64(%t7)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
