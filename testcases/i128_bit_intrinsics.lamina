# 128-bit bit intrinsics against the two-word lowering: zero, all ones, lone set bits in each word, MIN, MAX, and rotate counts at word and width boundaries.
fn @mk_u128(i64 %h, i64 %l) -> u128 {
entry:
  %hz = zext.i64.u128 %h
  %hs = shl.u128 %hz, 64
  %lz = zext.i64.u128 %l
  %v = or.u128 %hs, %lz
  ret.u128 %v
}

fn @mk_i128(i64 %h, i64 %l) -> i128 {
entry:
  %hz = zext.i64.i128 %h
  %hs = shl.i128 %hz, 64
  %lz = zext.i64.i128 %l
  %v = or.i128 %hs, %lz
  ret.i128 %v
}

fn @show_u(u128 %r) -> i64 {
entry:
  %lo = trunc.u128.u64 %r
  call @print_u64(%lo)
  %s = shr.u128 %r, 64
  %hi = trunc.u128.u64 %s
  call @print_u64(%hi)
  ret.i64 0
}

fn @show_i(i128 %r) -> i64 {
entry:
  %lo = trunc.i128.i64 %r
  call @print_i64(%lo)
  %s = shr.i128 %r, 64
  %hi = trunc.i128.i64 %s
  call @print_i64(%hi)
  ret.i64 0
}

