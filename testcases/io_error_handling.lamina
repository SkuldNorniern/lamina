# Test I/O error handling and return values
fn @main() -> i32 {
  entry:
    # Test writebyte return values (should be 1 on success)
    %w1 = writebyte 65  # Should return 1
    call @print_i64(%w1)

    %w2 = writebyte 66  # Should return 1
    call @print_i64(%w2)

    # Test readbyte (may return -1 if no input available)
    %r1 = readbyte
    call @print_i64(%r1)

    ret.i32 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
