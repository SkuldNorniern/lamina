fn @classify(i64 %x) -> i64 {
entry:
  %neg = lt.i64 %x, 0
  br %neg, negative, check
check:
  %zero = eq.i64 %x, 0
  br %zero, zero, positive
negative:
  ret.i64 -1
zero:
  ret.i64 0
positive:
  ret.i64 1
}

@noinline
fn @abort_path() -> i64 {
entry:
  unreachable
}

fn @main() -> i64 {
entry:
  %a = call @classify(-5)
  call @print_i64(%a)
  %b = call @classify(0)
  call @print_i64(%b)
  %c = call @classify(9)
  call @print_i64(%c)
  %d = lt.i64 %c, 0
  br %d, bad, good
bad:
  %e = call @abort_path()
  call @print_i64(%e)
  ret.i64 1
good:
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
