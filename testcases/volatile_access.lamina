fn @main() -> i64 {
entry:
 %slot = stackalloc.i64
 store.i64 %slot, 7
 %a = volatile load.i64 %slot
 call @print_i64(%a)
 volatile store.i64 %slot, 11
 %b = volatile load.i64 %slot
 call @print_i64(%b)
 %c = load.i64 %slot
 call @print_i64(%c)
 volatile store.i64 %slot, 13
 volatile store.i64 %slot, 17
 %d = volatile load.i64 %slot
 call @print_i64(%d)
 ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
