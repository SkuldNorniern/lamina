# Test recursive factorial with different inputs
fn @factorial(i64 %n) -> i64 {
  entry:
    %is_zero = eq.i64 %n, 0
    br %is_zero, base_case, recursive_case

  base_case:
    ret.i64 1

  recursive_case:
    %n_minus_1 = sub.i64 %n, 1
    %factorial_n_minus_1 = call @factorial(%n_minus_1)
    %result = mul.i64 %n, %factorial_n_minus_1
    ret.i64 %result
}

fn @main() -> i64 {
  entry:
    %result1 = call @factorial(0)  # Should be 1
    %result2 = call @factorial(1)  # Should be 1
    %result3 = call @factorial(2)  # Should be 2
    %result4 = call @factorial(3)  # Should be 6
    %result5 = call @factorial(4)  # Should be 24
    
    call @print_i64(%result1)
    call @print_i64(%result2)
    call @print_i64(%result3)
    call @print_i64(%result4)
    call @print_i64(%result5)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
