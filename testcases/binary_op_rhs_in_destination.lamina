# Integer ops whose right operand is also the destination register.
fn @main() -> i64 {
  entry:
    %in = readbyte
    %g = add.i64 %in, 3
    %g = and.i64 2816, %g
    jmp second
  second:
    call @print_i64(%g)
    %x = add.i64 %in, 2816
    %h = add.i64 %in, 3
    %h = and.i64 %x, %h
    call @print_i64(%h)
    %s = add.i64 %in, 40
    %k = add.i64 %in, 2
    %k = shr.i64 %s, %k
    call @print_i64(%k)
    %m = add.i64 %in, 2
    %m = shl.i64 40, %m
    call @print_i64(%m)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
