# copy.T moves one scalar in each type, and a reassigned name is read on the join.
fn @main() -> i64 {
entry:
  %slot = stackalloc.i64
  store.i64 %slot, 77
  %p = copy.ptr %slot
  %v = load.i64 %p
  call @print_i64(%v)
  %b = copy.bool true
  %x = copy.i64 0
  br %b, yes, no

yes:
  %x = copy.i64 5
  %t = copy.bool false
  jmp join

no:
  %x = copy.i64 9
  %t = copy.bool true
  jmp join

join:
  call @print_i64(%x)
  br %t, t_path, f_path

t_path:
  call @print_i64(1)
  jmp float

f_path:
  call @print_i64(0)
  jmp float

float:
  %fl = copy.f64 2.5
  %scaled = mul.f64 %fl, 4.0
  %n = fptoint.f64.i64 %scaled
  call @print_i64(%n)
  %big = copy.i128 4294967296
  %sq = mul.i128 %big, %big
  %acc = copy.i128 %sq
  %hi = shr.i128 %acc, 64
  %hin = trunc.i128.i64 %hi
  call @print_i64(%hin)
  %lo = trunc.i128.i64 %acc
  call @print_i64(%lo)
  ret.i64 0
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}
