# Test stack operations and local variables
fn @test_stack(i64 %x) -> i64 {
  entry:
    %local1 = add.i64 %x, 10
    %local2 = add.i64 %x, 20
    %local3 = add.i64 %x, 30
    %local4 = add.i64 %x, 40
    %local5 = add.i64 %x, 50
    
    %result = add.i64 %local1, %local2
    %result = add.i64 %result, %local3
    %result = add.i64 %result, %local4
    %result = add.i64 %result, %local5
    
    ret.i64 %result
}

fn @main() -> i64 {
  entry:
    %result1 = call @test_stack(100)  # Should be 100+10+20+30+40+50 = 250
    %result2 = call @test_stack(200)  # Should be 200+10+20+30+40+50 = 350
    %result3 = call @test_stack(300)  # Should be 300+10+20+30+40+50 = 450
    
    call @print_i64(%result1)
    call @print_i64(%result2)
    call @print_i64(%result3)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
