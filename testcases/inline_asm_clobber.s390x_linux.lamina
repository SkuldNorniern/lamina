# A callee clobbers r7 and r8 and must restore them; a value live across the call survives
fn @clobber() -> i64 {
entry:
  asm.void "lghi %r7, 99\nlghi %r8, 98", clobber(r7, r8)
  ret.i64 7
}

fn @main() -> i64 {
entry:
  %a = add.i64 40, 0
  %c = call @clobber()
  %s = add.i64 %a, %c
  asm.void "lghi %r7, 77", clobber(r7)
  %t = add.i64 %s, 0
  %ok = eq.i64 %t, 47
  br %ok, good, bad
good:
  %o = writebyte 79
  %k = writebyte 75
  %nl = writebyte 10
  ret.i64 0
bad:
  %f = writebyte 70
  %nl2 = writebyte 10
  ret.i64 1
}
