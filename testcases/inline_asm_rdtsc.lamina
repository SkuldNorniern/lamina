# rdtsc is read twice; the cycle counter must not go backwards
fn @main() -> i64 {
entry:
  %a = asm.i64 "rdtsc\nshlq $$32, %rdx\norq %rdx, %rax\nmovq %rax, $0", out(reg), clobber(rax, rdx, flags)
  %b = asm.i64 "rdtsc\nshlq $$32, %rdx\norq %rdx, %rax\nmovq %rax, $0", out(reg), clobber(rax, rdx, flags)
  %d = sub.i64 %b, %a
  %ok = gt.i64 %d, 0
  br %ok, good, bad
good:
  %o = writebyte 79
  %k = writebyte 75
  %n = writebyte 10
  ret.i64 0
bad:
  %f = writebyte 70
  %n2 = writebyte 10
  ret.i64 1
}
