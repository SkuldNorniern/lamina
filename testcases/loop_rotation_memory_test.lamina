# The loop test loads its bound from memory that a call in the body rewrites, so the
# test is not pure and the loop must keep re-reading the cell on every iteration.
fn @shrink_every_other(ptr %p, i64 %i) -> i64 {
  entry:
    %half = div.i64 %i, 2
    %back = mul.i64 %half, 2
    %even = eq.i64 %back, %i
    br %even, shrink, keep

  shrink:
    %cur = load.i64 %p
    %next = sub.i64 %cur, 1
    store.i64 %p, %next
    ret.i64 0

  keep:
    ret.i64 0
}

fn @main() -> i64 {
  entry:
    %cell = stackalloc.[1 x i64]
    %p = getelem.i64 %cell, 0
    store.i64 %p, 12
    %i = add.i64 0, 0
    jmp head

  head:
    %bound = load.i64 %p
    %more = lt.i64 %i, %bound
    br %more, body, done

  body:
    %dummy = call @shrink_every_other(%p, %i)
    %i = add.i64 %i, 1
    jmp head

  done:
    call @print_i64(%i)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
