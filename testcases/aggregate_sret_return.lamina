type !Quad = struct { a: i64, b: i64, c: i64, d: i64 }

fn @make(i64 %k) -> !Quad {
entry:
  %q = stackalloc.!Quad
  %f0 = getfieldptr %q, 0
  store.i64 %f0, %k
  %k1 = add.i64 %k, 1
  %f1 = getfieldptr %q, 1
  store.i64 %f1, %k1
  %k2 = add.i64 %k, 2
  %f2 = getfieldptr %q, 2
  store.i64 %f2, %k2
  %k3 = add.i64 %k, 3
  %f3 = getfieldptr %q, 3
  store.i64 %f3, %k3
  ret.ptr %q
}

fn @sum(!Quad %q) -> i64 {
entry:
  %pa = getfieldptr %q, 0
  %a = load.i64 %pa
  %pb = getfieldptr %q, 1
  %b = load.i64 %pb
  %pc = getfieldptr %q, 2
  %c = load.i64 %pc
  %pd = getfieldptr %q, 3
  %d = load.i64 %pd
  %s1 = add.i64 %a, %b
  %s2 = add.i64 %s1, %c
  %s3 = add.i64 %s2, %d
  ret.i64 %s3
}

fn @main() -> i64 {
entry:
  %q = call @make(10)
  %p1 = getfieldptr %q, 1
  %v1 = load.i64 %p1
  call @print_i64(%v1)
  %t = call @sum(%q)
  call @print_i64(%t)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
