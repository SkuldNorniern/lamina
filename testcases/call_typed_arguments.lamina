@extern
fn @printf(ptr %fmt, ...) -> i32

global $fmt: [13 x i8] = "%d %.1f %ld\n"

fn @add(i64 %a, i64 %b) -> i64 {
entry:
  %s = add.i64 %a, %b
  ret.i64 %s
}

fn @report(i64 %n) -> i32 {
entry:
  %r = call @printf(ptr $fmt, i32 7, 2.5, i64 %n)
  ret.i32 %r
}

fn @main() -> i64 {
entry:
  %s = call @add(i64 40, 2)
  %t = call @add(7, i64 %s)
  %r = call @report(i64 %t)
  ret.i64 0
}
