# Integer aggregates crossing a boundary by value: two words, one packed word, a
# padded three-field struct, a call whose aggregate lands on the stack, and
# aggregates returned in registers and fed straight back in.

type !Pair = struct { a: i64, b: i64 }
type !Small = struct { a: i32, b: i32 }
type !Three = struct { a: i32, b: i32, c: i32 }

fn @sum_pair(!Pair %p) -> i64 {
  entry:
    %ap = getfieldptr.!Pair %p, 0
    %bp = getfieldptr.!Pair %p, 1
    %a = load.i64 %ap
    %b = load.i64 %bp
    %s = add.i64 %a, %b
    ret.i64 %s
}

fn @sum_small(!Small %p) -> i64 {
  entry:
    %ap = getfieldptr.!Small %p, 0
    %bp = getfieldptr.!Small %p, 1
    %a = load.i32 %ap
    %b = load.i32 %bp
    %s = add.i32 %a, %b
    %w = extend.i32.i64 %s
    ret.i64 %w
}

fn @sum_three(!Three %p) -> i64 {
  entry:
    %ap = getfieldptr.!Three %p, 0
    %bp = getfieldptr.!Three %p, 1
    %cp = getfieldptr.!Three %p, 2
    %a = load.i32 %ap
    %b = load.i32 %bp
    %c = load.i32 %cp
    %ab = add.i32 %a, %b
    %s = add.i32 %ab, %c
    %w = extend.i32.i64 %s
    ret.i64 %w
}

fn @spilled(i64 %a, i64 %b, i64 %c, i64 %d, i64 %e, i64 %f, !Pair %p) -> i64 {
  entry:
    %ab = add.i64 %a, %b
    %cd = add.i64 %c, %d
    %ef = add.i64 %e, %f
    %abcd = add.i64 %ab, %cd
    %scalars = add.i64 %abcd, %ef
    %ap = getfieldptr.!Pair %p, 0
    %bp = getfieldptr.!Pair %p, 1
    %x = load.i64 %ap
    %y = load.i64 %bp
    %xy = add.i64 %x, %y
    %total = add.i64 %scalars, %xy
    ret.i64 %total
}

fn @make_pair(i64 %x) -> !Pair {
  entry:
    %p = stackalloc.!Pair
    %pa = getfieldptr.!Pair %p, 0
    %pb = getfieldptr.!Pair %p, 1
    store.i64 %pa, %x
    %y = add.i64 %x, 1
    store.i64 %pb, %y
    ret.ptr %p
}

fn @make_small(i32 %x) -> !Small {
  entry:
    %p = stackalloc.!Small
    %pa = getfieldptr.!Small %p, 0
    %pb = getfieldptr.!Small %p, 1
    store.i32 %pa, %x
    store.i32 %pb, 9
    ret.ptr %p
}

fn @main() -> i64 {
  entry:
    %pair = stackalloc.!Pair
    %pair_a = getfieldptr.!Pair %pair, 0
    %pair_b = getfieldptr.!Pair %pair, 1
    store.i64 %pair_a, 17
    store.i64 %pair_b, 25
    %sum = call @sum_pair(%pair)
    call @print_i64(%sum)

    %small = stackalloc.!Small
    %small_a = getfieldptr.!Small %small, 0
    %small_b = getfieldptr.!Small %small, 1
    store.i32 %small_a, 3
    store.i32 %small_b, 4
    %packed = call @sum_small(%small)
    call @print_i64(%packed)

    %three = stackalloc.!Three
    %three_a = getfieldptr.!Three %three, 0
    %three_b = getfieldptr.!Three %three, 1
    %three_c = getfieldptr.!Three %three, 2
    store.i32 %three_a, 1
    store.i32 %three_b, 2
    store.i32 %three_c, 3
    %padded = call @sum_three(%three)
    call @print_i64(%padded)

    %spill = call @spilled(1, 2, 3, 4, 5, 6, %pair)
    call @print_i64(%spill)

    %made = call @make_pair(41)
    %made_sum = call @sum_pair(%made)
    call @print_i64(%made_sum)

    %tiny = call @make_small(5)
    %tiny_sum = call @sum_small(%tiny)
    call @print_i64(%tiny_sum)

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
