# A sub-64-bit add keeps its own width when its result reaches a comparison
fn @main() -> i64 {
  entry:
    %a = add.i16 32767, 0
    %b = add.i16 %a, %a
    %c = lt.i16 %b, 1
    %d = zext.bool.i64 %c
    call @print_i64(%d)
    %e = add.i32 2000000000, 0
    %f = add.i32 %e, %e
    %g = lt.i32 %f, 0
    %h = zext.bool.i64 %g
    call @print_i64(%h)
    %i = add.i8 100, 0
    %j = add.i8 %i, %i
    %k = sext.i8.i64 %j
    call @print_i64(%k)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
