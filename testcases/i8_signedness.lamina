# i8 is signed and u8 is unsigned. The bit pattern 255 crossing a call boundary
# reads back as -1 for i8 and stays 255 for u8, so a compare below zero differs.
fn @mk_i8() -> i8 {
  entry:
    %v = trunc.i64.i8 255
    ret.i8 %v
}

fn @mk_u8() -> u8 {
  entry:
    %v = trunc.i64.u8 255
    ret.u8 %v
}

fn @main() -> i64 {
  entry:
    %c = call @mk_i8()
    %u = call @mk_u8()
    %cneg = lt.i8 %c, 0
    %uneg = lt.u8 %u, 0
    %cwide = sext.i8.i64 %c
    %uwide = zext.u8.i64 %u
    %cnegw = zext.bool.i64 %cneg
    %unegw = zext.bool.i64 %uneg
    print %cnegw
    print %unegw
    print %cwide
    print %uwide
    ret.i64 0
}
