# i8 is signed and u8 is unsigned. The bit pattern 255 crossing a call boundary
# reads back as -1 for i8 and stays 255 for u8, so a compare below zero differs.
fn @mk_i8() -> i8 {
  entry:
    %v = trunc.i64.i8 255
    ret.i8 %v
}

fn @mk_u8() -> u8 {
  entry:
    %v = trunc.i64.u8 255
    ret.u8 %v
}

fn @main() -> i64 {
  entry:
    %c = call @mk_i8()
    %u = call @mk_u8()
    %cneg = lt.i8 %c, 0
    %uneg = lt.u8 %u, 0
    %cwide = sext.i8.i64 %c
    %uwide = zext.u8.i64 %u
    %cnegw = zext.bool.i64 %cneg
    %unegw = zext.bool.i64 %uneg
    call @print_i64(%cnegw)
    call @print_i64(%unegw)
    call @print_i64(%cwide)
    call @print_i64(%uwide)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
