@extern
fn @malloc(i64 %n) -> ptr
@extern
fn @free(ptr %p) -> void

# Test heap memory allocation and deallocation
fn @test_heap_allocation() -> i64 {
  entry:
    # Allocate memory on heap
    %heap_ptr = call @malloc(4)
    %value = add.i32 42, 0

    # Store value in heap memory
    store.i32 %heap_ptr, %value

    # Load value back from heap
    %loaded = load.i32 %heap_ptr

    # Convert to i64 for return
    %loaded_i64 = zext.i32.i64 %loaded

    # Use the loaded value
    %result = add.i64 %loaded_i64, 8

    # Always deallocate heap memory
    call @free(%heap_ptr)

    ret.i64 %result
}

fn @test_multiple_heap_allocations() -> i64 {
  entry:
    # Allocate multiple heap objects
    %ptr1 = call @malloc(8)
    %ptr2 = call @malloc(8)
    %ptr3 = call @malloc(8)

    # Store different values
    store.i64 %ptr1, 100
    store.i64 %ptr2, 200
    store.i64 %ptr3, 300

    # Load and compute
    %val1 = load.i64 %ptr1
    %val2 = load.i64 %ptr2
    %val3 = load.i64 %ptr3

    %sum1 = add.i64 %val1, %val2
    %total = add.i64 %sum1, %val3

    # Clean up all allocations
    call @free(%ptr1)
    call @free(%ptr2)
    call @free(%ptr3)

    ret.i64 %total
}

fn @main() -> i64 {
  entry:
    %result1 = call @test_heap_allocation()  # Should return 50 (42 + 8)
    %result2 = call @test_multiple_heap_allocations()  # Should return 600 (100 + 200 + 300)

    call @print_i64(%result1)
    call @print_i64(%result2)

    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
