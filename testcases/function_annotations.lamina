@hidden
fn @hidden_fn() -> i64 {
entry:
  ret.i64 1
}

@protected
fn @protected_fn() -> i64 {
entry:
  ret.i64 2
}

@internal
fn @internal_fn() -> i64 {
entry:
  ret.i64 3
}

@private
fn @private_fn() -> i64 {
entry:
  ret.i64 4
}

@cold
fn @cold_fn() -> i64 {
entry:
  ret.i64 5
}

@hot
fn @hot_fn() -> i64 {
entry:
  ret.i64 6
}

@inline
fn @inline_fn() -> i64 {
entry:
  ret.i64 7
}

@pure
fn @pure_fn(i64 %x) -> i64 {
entry:
  %y = add.i64 %x, 1
  ret.i64 %y
}

@extern
@noreturn
fn @exit(i32 %code) -> void

fn @main() -> i64 {
entry:
  %a = call @hidden_fn()
  call @print_i64(%a)
  %b = call @protected_fn()
  call @print_i64(%b)
  %c = call @internal_fn()
  call @print_i64(%c)
  %d = call @private_fn()
  call @print_i64(%d)
  %e = call @cold_fn()
  call @print_i64(%e)
  %f = call @hot_fn()
  call @print_i64(%f)
  %g = call @inline_fn()
  call @print_i64(%g)
  %unused = call @pure_fn(9)
  call @exit(0)
  call @print_i64(99)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
