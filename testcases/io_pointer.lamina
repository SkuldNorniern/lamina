# Test pointer-based operations with print output
fn @main() -> i32 {
  entry:
    # Allocate buffer
    %buffer = stackalloc.i32

    # Store value in buffer
    store.i32 %buffer, 42

    # Load value from buffer
    %buffer_val = load.i32 %buffer

    # Print the buffer value to verify it worked
    %pv0 = extend.i32.i64 %buffer_val
    call @print_i64(%pv0)

    ret.i32 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
