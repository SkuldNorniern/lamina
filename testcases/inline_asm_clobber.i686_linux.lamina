# A callee clobbers ebx and esi and must restore them; a value live across the call survives
fn @clobber() -> i64 {
entry:
  asm.void "movl $$99, %ebx\nmovl $$98, %esi", clobber(ebx, esi)
  ret.i64 7
}

fn @main() -> i64 {
entry:
  %a = add.i64 40, 0
  %c = call @clobber()
  %s = add.i64 %a, %c
  asm.void "movl $$77, %ebx", clobber(ebx)
  %t = add.i64 %s, 0
  %ok = eq.i64 %t, 47
  br %ok, good, bad
good:
  %o = writebyte 79
  %k = writebyte 75
  %nl = writebyte 10
  ret.i64 0
bad:
  %f = writebyte 70
  %nl2 = writebyte 10
  ret.i64 1
}
