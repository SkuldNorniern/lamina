@extern
fn @printf(ptr %fmt, ...) -> i32

@extern
fn @fflush(ptr %f) -> i32

global $fmt_g: [4 x i8] = "%g\n"

fn @half(f64 %x) -> f64 {
entry:
 %h = div.f64 %x, 2.0
 ret.f64 %h
}

fn @main() -> i64 {
entry:
 %a = add.f64 1.5, 2.25
 call @print_f64(%a)
 %b = call @half(%a)
 call @print_f64(%b)
 %c = add.f32 0.5, 0.25
 %pv2 = fpcast.f32.f64 %c
 call @print_f64(%pv2)
 call @print_f64(3.5)
 %d = div.f64 1.0, 3.0
 call @print_f64(%d)
 %e = sub.f64 0.0, 2.5
 call @print_f64(%e)
 ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}

fn @print_f64(f64 %x) -> i64 {
entry:
  %p = getelem.i8 $fmt_g, 0
  %r = call @printf(%p, %x)
  %n = inttoptr.i64 0
  %z = call @fflush(%n)
  ret.i64 0
}
