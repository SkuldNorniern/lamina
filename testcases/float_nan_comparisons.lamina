# Every ordered comparison is false when an operand is NaN; only ne is true
fn @cmp(f64 %z, f64 %x) -> i64 {
  entry:
    %nan = div.f64 %z, %z
    %a = eq.f64 %nan, %x
    %ra = zext.bool.i64 %a
    call @print_i64(%ra)
    %b = ne.f64 %nan, %x
    %rb = zext.bool.i64 %b
    call @print_i64(%rb)
    %c = lt.f64 %nan, %x
    %rc = zext.bool.i64 %c
    call @print_i64(%rc)
    %d = le.f64 %nan, %x
    %rd = zext.bool.i64 %d
    call @print_i64(%rd)
    %e = gt.f64 %nan, %x
    %re = zext.bool.i64 %e
    call @print_i64(%re)
    %f = ge.f64 %nan, %x
    %rf = zext.bool.i64 %f
    call @print_i64(%rf)
    %g = le.f64 %x, %nan
    %rg = zext.bool.i64 %g
    call @print_i64(%rg)
    %h = ge.f64 %x, %nan
    %rh = zext.bool.i64 %h
    call @print_i64(%rh)
    ret.i64 0
}
fn @main() -> i64 {
  entry:
    %r = call @cmp(0.0, 1.5)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
