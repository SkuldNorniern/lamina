fn @callee(ptr %p) -> i64 {
entry:
 %byte = readbyte
 %v = add.i64 %byte, 99
 %slot = stackalloc.i64
 store.i64 %slot, %v
 %x = load.i64 %p
 %c = eq.i64 %x, -999
 br %c, recurse, done
recurse:
 %r = call @callee(%p)
 ret.i64 %r
done:
 ret.i64 %x
}
fn @caller(i64 %unused) -> i64 {
entry:
 %p = stackalloc.i64
 %byte = readbyte
 %v = add.i64 %byte, 106
 store.i64 %p, %v
 %r = call @callee(%p)
 ret.i64 %r
}
fn @main() -> i64 {
entry:
 %r = call @caller(0)
 call @print_i64(%r)
 ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
