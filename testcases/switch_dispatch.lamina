fn @pick(i32 %k) -> i64 {
entry:
  switch.i32 %k, other, [0, zero], [3, three], [7, seven]
zero:
  %a = add.i64 100, 0
  jmp done
three:
  %b = add.i64 300, 0
  jmp done
seven:
  %c = add.i64 700, 0
  jmp done
other:
  %d = sub.i64 0, 1
  jmp done
done:
  %out = phi.i64 [%a, zero], [%b, three], [%c, seven], [%d, other]
  ret.i64 %out
}

fn @main() -> i64 {
entry:
  %i0 = add.i64 0, 0
  %acc0 = add.i64 0, 0
  jmp loop
loop:
  %i = phi.i64 [%i0, entry], [%inext, loop]
  %acc = phi.i64 [%acc0, entry], [%accnext, loop]
  %k = trunc.i64.i32 %i
  %got = call @pick(%k)
  call @print_i64(%got)
  %accnext = add.i64 %acc, %got
  %inext = add.i64 %i, 1
  %more = lt.i64 %inext, 9
  br %more, loop, after
after:
  call @print_i64(%accnext)
  ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
