# A float unary whose result name is its own operand. The operand is the previous
# definition; negating bits 5 sets the sign bit, giving 2^63 + 5, which is -9223372036854775803 as i64.
fn @main() -> i64 {
  entry:
    %z = add.i64 0, 5
    %x = bitcast.i64.f64 %z
    %x = neg.f64 %x
    %y = bitcast.f64.i64 %x
    call @print_i64(%y)
    ret.i64 0
}

fn @put_u64(u64 %n) -> void {
entry:
  %q = div.u64 %n, 10
  %r = rem.u64 %n, 10
  %d = add.u64 %r, 48
  %z = eq.u64 %q, 0
  br %z, last, more
more:
  call @put_u64(%q)
  jmp last
last:
  %w = writebyte %d
  ret.void
}

fn @print_u64(u64 %n) -> void {
entry:
  call @put_u64(%n)
  %nl = writebyte 10
  ret.void
}

fn @print_i64(i64 %n) -> void {
entry:
  %neg = lt.i64 %n, 0
  %m = sub.i64 0, %n
  %s = select.i64 %neg, %m, %n
  %u = bitcast.i64.u64 %s
  br %neg, minus, digits
minus:
  %c = writebyte 45
  jmp digits
digits:
  call @put_u64(%u)
  %nl = writebyte 10
  ret.void
}
