@kernel fn @barrier() -> void {
entry:
call @__lamina_gpu_workgroup_barrier()
ret.void
}

@kernel fn @arguments(i32 %a, i64 %b, ptr %out) -> void {
entry:
ret.void
}

@kernel fn @ids() -> void {
entry:
%x = call @__lamina_gpu_thread_id_x()
%y = call @__lamina_gpu_thread_id_y()
%z = call @__lamina_gpu_thread_id_z()
%gx = call @__lamina_gpu_block_id_x()
%gy = call @__lamina_gpu_block_id_y()
%gz = call @__lamina_gpu_block_id_z()
ret.void
}

@kernel fn @group_ids_with_kernarg(i32 %arg) -> void {
entry:
%x = call @__lamina_gpu_block_id_x()
%y = call @__lamina_gpu_block_id_y()
%z = call @__lamina_gpu_block_id_z()
ret.void
}

@kernel fn @arithmetic32(ptr %out, i32 %a, i32 %b) -> void {
entry:
%add = add.i32 %a, %b
%sub = sub.i32 %a, %b
%mul = mul.i32 %a, %b
%and = and.i32 %a, %b
%or = or.i32 %a, %b
%xor = xor.i32 %a, %b
%left = shl.i32 %a, 3
%right = shr.u32 %b, 4
%signed = shr.i32 %a, 31
%p0 = getelem.ptr %out, 0, i32
store.i32 %p0, %add
%p1 = getelem.ptr %out, 1, i32
store.i32 %p1, %sub
%p2 = getelem.ptr %out, 2, i32
store.i32 %p2, %mul
%p3 = getelem.ptr %out, 3, i32
store.i32 %p3, %and
%p4 = getelem.ptr %out, 4, i32
store.i32 %p4, %or
%p5 = getelem.ptr %out, 5, i32
store.i32 %p5, %xor
%p6 = getelem.ptr %out, 6, i32
store.i32 %p6, %left
%p7 = getelem.ptr %out, 7, i32
store.i32 %p7, %right
%p8 = getelem.ptr %out, 8, i32
store.i32 %p8, %signed
ret.void
}

@kernel fn @arithmetic64(ptr %out, i64 %a, i64 %b) -> void {
entry:
%add = add.i64 %a, %b
%sub = sub.i64 %a, %b
%mul = mul.i64 %a, %b
%and = and.i64 %a, %b
%or = or.i64 %a, %b
%xor = xor.i64 %a, %b
%immediate = add.i64 %a, 4294967295
%p0 = getelem.ptr %out, 0, i64
store.i64 %p0, %add
%p1 = getelem.ptr %out, 1, i64
store.i64 %p1, %sub
%p2 = getelem.ptr %out, 2, i64
store.i64 %p2, %mul
%p3 = getelem.ptr %out, 3, i64
store.i64 %p3, %and
%p4 = getelem.ptr %out, 4, i64
store.i64 %p4, %or
%p5 = getelem.ptr %out, 5, i64
store.i64 %p5, %xor
%p6 = getelem.ptr %out, 6, i64
store.i64 %p6, %immediate
%left = shl.i64 %a, 3
%right = shr.u64 %b, 4
%signed = shr.i64 %a, 31
%p7 = getelem.ptr %out, 7, i64
store.i64 %p7, %left
%p8 = getelem.ptr %out, 8, i64
store.i64 %p8, %right
%p9 = getelem.ptr %out, 9, i64
store.i64 %p9, %signed
ret.void
}

@kernel fn @conversions(ptr %out, i32 %a, i64 %b, ptr %p) -> void {
entry:
%zero = zext.i32.i64 %a
%sign = sext.i32.i64 %a
%narrow = trunc.i64.i32 %b
%address = ptrtoint %p, .i64
%back = inttoptr %address, .i64
store.i64 %out, %zero
%p1 = getelem.ptr %out, 1, i64
store.i64 %p1, %sign
%p2 = getelem.ptr %out, 2, i64
store.i32 %p2, %narrow
%roundtrip = ptrtoint %back, .i64
%p3 = getelem.ptr %out, 3, i64
store.i64 %p3, %roundtrip
ret.void
}

@kernel fn @vector_add(ptr %out, ptr %left, ptr %right, i32 %stride) -> void {
entry:
%tid = call @__lamina_gpu_thread_id_x()
%group = call @__lamina_gpu_block_id_x()
%base = mul.i32 %group, %stride
%index = add.i32 %base, %tid
%wide = zext.i32.i64 %index
%lp = getelem.ptr %left, %wide, i32
%rp = getelem.ptr %right, %wide, i32
%op = getelem.ptr %out, %wide, i32
%a = load.i32 %lp
%b = load.i32 %rp
%sum = add.i32 %a, %b
store.i32 %op, %sum
ret.void
}

@kernel fn @load_store64(ptr %out, ptr %input) -> void {
entry:
%value = load.i64 %input
%sum = add.i64 %value, 1
store.i64 %out, %sum
ret.void
}

@kernel fn @coordinates(ptr %out) -> void {
entry:
%x = call @__lamina_gpu_thread_id_x()
%y = call @__lamina_gpu_thread_id_y()
%z = call @__lamina_gpu_thread_id_z()
%gx = call @__lamina_gpu_block_id_x()
%gy = call @__lamina_gpu_block_id_y()
%gz = call @__lamina_gpu_block_id_z()
%local0 = mul.i32 %z, 3
%local1 = add.i32 %local0, %y
%local2 = mul.i32 %local1, 4
%local = add.i32 %local2, %x
%group0 = mul.i32 %gz, 2
%group1 = add.i32 %group0, %gy
%group2 = mul.i32 %group1, 2
%group = add.i32 %group2, %gx
%base = mul.i32 %group, 24
%index = add.i32 %base, %local
%wide = zext.i32.i64 %index
%p = getelem.ptr %out, %wide, i32
%sy = shl.i32 %y, 4
%sz = shl.i32 %z, 8
%sgx = shl.i32 %gx, 16
%sgy = shl.i32 %gy, 20
%sgz = shl.i32 %gz, 24
%c0 = or.i32 %x, %sy
%c1 = or.i32 %c0, %sz
%c2 = or.i32 %c1, %sgx
%c3 = or.i32 %c2, %sgy
%code = or.i32 %c3, %sgz
store.i32 %p, %code
ret.void
}

@kernel fn @vector_add64(ptr %out, ptr %left, ptr %right, i32 %stride) -> void {
entry:
%tid = call @__lamina_gpu_thread_id_x()
%group = call @__lamina_gpu_block_id_x()
%base = mul.i32 %group, %stride
%index = add.i32 %base, %tid
%wide = zext.i32.i64 %index
%lp = getelem.ptr %left, %wide, i64
%rp = getelem.ptr %right, %wide, i64
%op = getelem.ptr %out, %wide, i64
%a = load.i64 %lp
%b = load.i64 %rp
%sum = add.i64 %a, %b
store.i64 %op, %sum
ret.void
}

@kernel fn @vector_mul64(ptr %out, ptr %left, ptr %right, i32 %stride) -> void {
entry:
%tid = call @__lamina_gpu_thread_id_x()
%group = call @__lamina_gpu_block_id_x()
%base = mul.i32 %group, %stride
%index = add.i32 %base, %tid
%wide = zext.i32.i64 %index
%lp = getelem.ptr %left, %wide, i64
%rp = getelem.ptr %right, %wide, i64
%op = getelem.ptr %out, %wide, i64
%a = load.i64 %lp
%b = load.i64 %rp
%sum = mul.i64 %a, %b
store.i64 %op, %sum
ret.void
}

@kernel fn @dimensions_without_kernarg() -> void {
entry:
%blockx = call @__lamina_gpu_block_dim_x()
%blocky = call @__lamina_gpu_block_dim_y()
%blockz = call @__lamina_gpu_block_dim_z()
%gridx = call @__lamina_gpu_grid_dim_x()
%gridy = call @__lamina_gpu_grid_dim_y()
%gridz = call @__lamina_gpu_grid_dim_z()
ret.void
}

@kernel fn @dimensions(ptr %out, i64 %bias) -> void {
entry:
%dx = call @__lamina_gpu_block_dim_x()
%dy = call @__lamina_gpu_block_dim_y()
%dz = call @__lamina_gpu_block_dim_z()
%gridx = call @__lamina_gpu_grid_dim_x()
%gridy = call @__lamina_gpu_grid_dim_y()
%gridz = call @__lamina_gpu_grid_dim_z()
%threadx = call @__lamina_gpu_thread_id_x()
%thready = call @__lamina_gpu_thread_id_y()
%threadz = call @__lamina_gpu_thread_id_z()
%blockx = call @__lamina_gpu_block_id_x()
%blocky = call @__lamina_gpu_block_id_y()
%blockz = call @__lamina_gpu_block_id_z()
%g0 = mul.i32 %blockz, %gridy
%g1 = add.i32 %g0, %blocky
%g2 = mul.i32 %g1, %gridx
%group = add.i32 %g2, %blockx
%t0 = mul.i32 %threadz, %dy
%t1 = add.i32 %t0, %thready
%t2 = mul.i32 %t1, %dx
%thread = add.i32 %t2, %threadx
%b0 = mul.i32 %dx, %dy
%b1 = mul.i32 %b0, %dz
%base = mul.i32 %group, %b1
%index = add.i32 %base, %thread
%stride = mul.i32 %index, 8
%wide = zext.i32.i64 %stride
%record = getelem.ptr %out, %wide, i32
%p0 = getelem.ptr %record, 0, i32
store.i32 %p0, %dx
%p1 = getelem.ptr %record, 1, i32
store.i32 %p1, %dy
%p2 = getelem.ptr %record, 2, i32
store.i32 %p2, %dz
%p3 = getelem.ptr %record, 3, i32
store.i32 %p3, %gridx
%p4 = getelem.ptr %record, 4, i32
store.i32 %p4, %gridy
%p5 = getelem.ptr %record, 5, i32
store.i32 %p5, %gridz
%sum = add.i64 %bias, 1
%p6 = getelem.ptr %record, 3, i64
store.i64 %p6, %sum
ret.void
}
