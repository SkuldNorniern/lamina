@extern
fn @__fixunssfti(f32 %x) -> i128

@export
fn @__fixsfti(f32 %x) -> i128 {
entry:
  %b = bitcast.f32.u32 %x
  %sb = shr.u32 %b, 31
  %neg = ne.u32 %sb, 0
  %ab = and.u32 %b, 2147483647
  %nan = gt.u32 %ab, 2139095040
  br %nan, zero, conv

zero:
  ret.i128 0

conv:
  %ax = bitcast.u32.f32 %ab
  %mag = call @__fixunssfti(%ax)
  %top = shr.i128 %mag, 127
  %sat = ne.i128 %top, 0
  br %sat, satur, body

satur:
  %minv = shl.i128 1, 127
  %maxv = add.i128 %minv, -1
  %sr = select.i128 %neg, %minv, %maxv
  ret.i128 %sr

body:
  %nm = sub.i128 0, %mag
  %res = select.i128 %neg, %nm, %mag
  ret.i128 %res
}
