@extern
fn @__fixunsdfti(f64 %x) -> i128

@export
fn @__fixdfti(f64 %x) -> i128 {
entry:
  %b = bitcast.f64.u64 %x
  %sb = shr.u64 %b, 63
  %neg = ne.u64 %sb, 0
  %ab = and.u64 %b, 9223372036854775807
  %nan = gt.u64 %ab, 9218868437227405312
  br %nan, zero, conv

zero:
  ret.i128 0

conv:
  %ax = bitcast.u64.f64 %ab
  %mag = call @__fixunsdfti(%ax)
  %top = shr.i128 %mag, 127
  %sat = ne.i128 %top, 0
  br %sat, satur, body

satur:
  %minv = shl.i128 1, 127
  %maxv = add.i128 %minv, -1
  %sr = select.i128 %neg, %minv, %maxv
  ret.i128 %sr

body:
  %nm = sub.i128 0, %mag
  %res = select.i128 %neg, %nm, %mag
  ret.i128 %res
}
