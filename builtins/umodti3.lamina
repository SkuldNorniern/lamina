@export
fn @__umodti3(u128 %n, u128 %d) -> u128 {
entry:
  %dlo = trunc.u128.u64 %d
  %dhs = shr.u128 %d, 64
  %dhi = trunc.u128.u64 %dhs
  %dor = or.u64 %dlo, %dhi
  %trap = div.u64 1, %dor
  %nhs = shr.u128 %n, 64
  %nhi = trunc.u128.u64 %nhs
  %nlo = trunc.u128.u64 %n
  %wide = or.u64 %nhi, %dhi
  %small = eq.u64 %wide, 0
  br %small, fast, init

init:
  %nn = copy.u128 %n
  %qv = copy.u128 0
  %rv = copy.u128 0
  %kv = copy.u64 128
  jmp loop

fast:
  %q64 = rem.u64 %nlo, %dlo
  %q = extend.u64.u128 %q64
  ret.u128 %q

loop:
  %done = eq.u64 %kv, 0
  br %done, exit, body

body:
  %top = shr.u128 %nn, 127
  %nn2 = shl.u128 %nn, 1
  %rtop = shr.u128 %rv, 127
  %r1 = shl.u128 %rv, 1
  %r2 = or.u128 %r1, %top
  %ov = ne.u128 %rtop, 0
  br %ov, take, cmp

cmp:
  %ge = ge.u128 %r2, %d
  br %ge, take, keep

take:
  %rt = sub.u128 %r2, %d
  %qs = shl.u128 %qv, 1
  %qt = or.u128 %qs, 1
  %r3 = copy.u128 %rt
  %q2 = copy.u128 %qt
  jmp next

keep:
  %qk = shl.u128 %qv, 1
  %r3 = copy.u128 %r2
  %q2 = copy.u128 %qk
  jmp next

next:
  %k2 = sub.u64 %kv, 1
  %nn = copy.u128 %nn2
  %qv = copy.u128 %q2
  %rv = copy.u128 %r3
  %kv = copy.u64 %k2
  jmp loop

exit:
  ret.u128 %rv
}
