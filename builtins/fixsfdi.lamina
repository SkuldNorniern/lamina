@extern
fn @__fixunssfdi(f32 %x) -> i64

@export
fn @__fixsfdi(f32 %x) -> i64 {
entry:
  %b = bitcast.f32.u32 %x
  %sb = shr.u32 %b, 31
  %neg = ne.u32 %sb, 0
  %ab = and.u32 %b, 2147483647
  %nan = gt.u32 %ab, 2139095040
  br %nan, zero, conv

zero:
  ret.i64 0

conv:
  %ax = bitcast.u32.f32 %ab
  %mag = call @__fixunssfdi(%ax)
  %top = shr.i64 %mag, 63
  %sat = ne.i64 %top, 0
  br %sat, satur, body

satur:
  %minv = shl.i64 1, 63
  %maxv = add.i64 %minv, -1
  %sr = select.i64 %neg, %minv, %maxv
  ret.i64 %sr

body:
  %nm = sub.i64 0, %mag
  %res = select.i64 %neg, %nm, %mag
  ret.i64 %res
}
