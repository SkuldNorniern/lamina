@export
fn @__floatundidf(u64 %x) -> f64 {
entry:
  %z = eq.u64 %x, 0
  br %z, zero, nz

zero:
  ret.f64 0.0

nz:
  %half = shl.u64 1, 63
  %c0 = lt.u64 %x, 4294967296
  %s0 = shl.u64 %x, 32
  %x0 = select.u64 %c0, %s0, %x
  %n0 = select.u32 %c0, 32, 0
  %c1 = lt.u64 %x0, 281474976710656
  %s1 = shl.u64 %x0, 16
  %x1 = select.u64 %c1, %s1, %x0
  %a1 = select.u32 %c1, 16, 0
  %n1 = add.u32 %n0, %a1
  %c2 = lt.u64 %x1, 72057594037927936
  %s2 = shl.u64 %x1, 8
  %x2 = select.u64 %c2, %s2, %x1
  %a2 = select.u32 %c2, 8, 0
  %n2 = add.u32 %n1, %a2
  %c3 = lt.u64 %x2, 1152921504606846976
  %s3 = shl.u64 %x2, 4
  %x3 = select.u64 %c3, %s3, %x2
  %a3 = select.u32 %c3, 4, 0
  %n3 = add.u32 %n2, %a3
  %c4 = lt.u64 %x3, 4611686018427387904
  %s4 = shl.u64 %x3, 2
  %x4 = select.u64 %c4, %s4, %x3
  %a4 = select.u32 %c4, 2, 0
  %n4 = add.u32 %n3, %a4
  %c5 = lt.u64 %x4, %half
  %s5 = shl.u64 %x4, 1
  %y = select.u64 %c5, %s5, %x4
  %a5 = select.u32 %c5, 1, 0
  %sh = add.u32 %n4, %a5
  %m = shr.u64 %y, 11
  %r = and.u64 %y, 2047
  %odd = and.u64 %m, 1
  %t0 = add.u64 %r, 1023
  %t1 = add.u64 %t0, %odd
  %inc = shr.u64 %t1, 11
  %mr = add.u64 %m, %inc
  %frac = sub.u64 %mr, 4503599627370496
  %e32 = sub.u32 1086, %sh
  %e = extend.u32.u64 %e32
  %eb = shl.u64 %e, 52
  %bits = add.u64 %eb, %frac
  %res = bitcast.u64.f64 %bits
  ret.f64 %res
}
